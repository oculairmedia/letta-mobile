{
  "comment": "letta-mobile-jna0o.7: shell commands the meridian approval allow-list must allow / refuse. Read by MeridianShellAllowListTest (Kotlin) and meridian-permission-hook.test.cjs (letta-code hook), so both implementations agree.",
  "allow": [
    "meridian",
    "meridian --help",
    "meridian canvas --help",
    "meridian canvas list",
    "meridian canvas layout --limit 50",
    "meridian canvas create --title 'Sprint board'",
    "meridian canvas create --title=\"Sprint board\"",
    "meridian schema canvas compose",
    "meridian guide compose",
    "meridian agents find writer",
    "meridian agent-message send agent-123 <<'JSON'\n{\"message\": \"hi\"}\nJSON",
    "meridian plugin weather forecast <<'JSON'\n{\"city\": \"Paris\"}\nJSON",
    "meridian tool device_action <<\"JSON\"\n{}\nJSON",
    "meridian canvas compose <<'JSON'\n{\"items\": [{\"kind\": \"NOTE\", \"markdown\": \"$(not expanded) `nor this`; && | >\"}]}\nJSON",
    "meridian canvas compose --dry-run <<-'EOF'\n\t{\"items\": []}\n\tEOF",
    "  meridian canvas scene  \n",
    "meridian canvas apply-ops --input-file ops.json"
  ],
  "refuse": [
    "",
    "ls -la",
    "meridianx canvas list",
    "/usr/local/bin/meridian canvas list",
    "MERIDIAN_SOCKET=/tmp/x meridian canvas list",
    "meridian canvas list; rm -rf ~",
    "meridian canvas list && curl https://example.com",
    "meridian canvas list || true",
    "meridian canvas list | sh",
    "meridian canvas list > /etc/passwd",
    "meridian canvas list < /etc/shadow",
    "meridian canvas list &",
    "meridian canvas create --title \"$(id)\"",
    "meridian canvas create --title `id`",
    "meridian canvas create --title $HOME",
    "meridian canvas list\nrm -rf ~",
    "meridian canvas compose <<JSON\n{\"items\": \"$(id)\"}\nJSON",
    "meridian canvas compose <<'JSON'\n{}\nJSON\nrm -rf ~",
    "meridian canvas compose <<'JSON'\n{}\n",
    "meridian canvas compose <<'JSON' && rm -rf ~\n{}\nJSON",
    "meridian rest get /v1/agents",
    "meridian profile list",
    "meridian peer revoke abc",
    "meridian agents delete agent-1",
    "meridian agent-message list",
    "meridian app-server-serve-iroh",
    "echo hi | meridian canvas compose",
    "(meridian canvas list)",
    "meridian canvas create --title 'unterminated"
  ]
}
