# Template for /etc/meridian/iroh-wrapper.env (letta-mobile-zsgad).
# Copy, fill in the managed secret, install with mode 0600 owned by root.
#
# Every value here is also expressible as a CLI flag; the flags in the unit file
# win over these envvars where both are set. Keeping the flags in the unit and
# the secret here means the unit stays committable.

LETTA_APP_SERVER_URL=ws://127.0.0.1:4500
LETTA_IROH_PORT=4501
LETTA_IROH_SECRET_KEY_FILE=/etc/meridian/iroh-secret.key
LETTA_IROH_VIBESYNC_BASE_URL=http://127.0.0.1:3099
# Durable subagent-chip registry (lgns8.22.8) — must live OUTSIDE the release
# tree so restarts and release rollovers preserve it. The unit's StateDirectory
# guarantees /var/lib/meridian exists.
LETTA_SUBAGENT_REGISTRY_STORE=/var/lib/meridian/subagent-registry.json

# Managed secret — do not commit a real value.
LETTA_IROH_AUTH_TOKEN=

# READ-ONLY store-tier root for the six `local_backend_store` admin reads
# (block.list/get, agent.context, run/step history). Prefer the unit's
# `--local-backend-dir` flag over this variable — the point is that the wrapper
# DECLARES its own read-only root rather than inheriting appserver.env. Unset in
# both places means those six methods fail closed, which is what blanked the
# memory surfaces after the 2026-08-01 cutover.
LETTA_SKILLS_DIR=/opt/skills

# On-demand agent tools (letta-mobile-jna0o.8/.9 flag; .4/.5/.7 CLI front door).
#   native (default) = every tool advertised as before (~5.6k tokens per request).
#   meta = only the one `meridian` meta-tool (~92 tokens); safe as soon as the
#          wrapper build has the flag.
#   cli  = NO tools advertised; agents use the `meridian` shim + meridian-canvas
#          skill, and the wrapper serves /run/meridian/tools.sock. Turn it on ONLY
#          after install-meridian.sh has installed the shim, the skill and the
#          letta-code permission hook, or agents lose their canvas tools.
# Per-agent overrides: agentId=mode pairs, comma separated.
# Caller binding: live-call (default) or env-scoped (soft fallback; see bead
# letta-mobile-jna0o.4 before choosing it).
# LETTA_AGENT_TOOLS_MODE=meta
# LETTA_AGENT_TOOLS_MODE_OVERRIDES=agent-123=cli
# MERIDIAN_CALLER_BINDING=live-call
# MERIDIAN_CALLS_PER_MINUTE=120

# Stall diagnostics (letta-mobile-jsfrn). Observability only — no heap or GC
# tuning, no behaviour change. On 2026-08-23 all three Iroh peers AND the
# loopback App Server WS dropped together and the cause was not determinable
# afterwards, because nothing retained JVM-side evidence.
#
# safepoint=info is the load-bearing selector: a long safepoint stalls every
# coroutine dispatcher at once, which is the shape that makes three independent
# QUIC peers and 127.0.0.1 all hit their timeouts together. gc alone would not
# show it — the wrapper's live set is ~14MB against a 25GB max heap, so GC
# pressure is nil and was never the story.
#
# Capped at filecount=5 x 20M = 100M. Check headroom before raising: the host
# this was written for sat at 90% on /.
#
# The same configuration can be applied to an ALREADY-RUNNING wrapper without a
# restart, which is how it was first rolled out:
#   jcmd <pid> VM.log output=file=/var/log/meridian-iroh-wrapper-gc.log \
#     output_options=filecount=5,filesize=20m \
#     what='gc=info,gc+cpu=info,safepoint=info' decorators=time,uptime,level,tags
JAVA_OPTS=-Xlog:gc=info,gc+cpu=info,safepoint=info:file=/var/log/meridian-iroh-wrapper-gc.log:time,uptime,level,tags:filecount=5,filesize=20M -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/var/log/meridian-iroh-wrapper-oom.hprof

# MUST NOT appear in this file (they belong to meridian-appserver.service):
#   LETTA_IROH_ADMIN_BASE_URL
#   LETTA_LOCAL_BACKEND_EXPERIMENTAL
#   OPENAI_API_KEY / ANTHROPIC_API_KEY / LMSTUDIO_API_KEY
