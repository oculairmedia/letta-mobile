# Repository-owned template for /etc/meridian/appserver.env — the App Server's
# EnvironmentFile. THIS FILE IS NOT THE LIVE ENV: copy it, fill the secrets, and
# keep the live copy off the repo. Secrets here are placeholders by design.
#
# Companion to scripts/deploy/iroh-wrapper.env.example.

# --- Upstream model proxies -------------------------------------------------
# Local proxies, not vendor endpoints: llmux on :4000, the Anthropic Max proxy
# on :8082. Keys are the proxies' own, not vendor keys.
OPENAI_BASE_URL=http://localhost:4000/v1
LMSTUDIO_BASE_URL=http://localhost:4000/v1
ANTHROPIC_BASE_URL=http://localhost:8082
OPENAI_API_KEY=REPLACE_ME
LMSTUDIO_API_KEY=REPLACE_ME
ANTHROPIC_API_KEY=not-needed

# --- Local backend ----------------------------------------------------------
LETTA_LOCAL_BACKEND_DIR=/root/.letta/lc-local-backend
LETTA_LOCAL_BACKEND_EXPERIMENTAL=1
LETTA_SKILLS_DIR=/opt/skills

# Host-specific: the agent and conversation this deployment answers as.
LETTA_AGENT_ID=REPLACE_ME
LETTA_CONVERSATION_ID=REPLACE_ME
LETTA_IROH_AUTH_TOKEN=REPLACE_ME

HOME=/root
USER=root

# Substring match against the model id; anything matching may receive images.
LETTA_VISION_MODELS=llava,vision,opus,sonnet,haiku,claude,fable,gpt-,gpt5,gemini,grok,minimax,qwen-vl,qwen2-vl,qwen2.5-vl

# --- letta-code bundle and runtime patches ----------------------------------
# LETTA_CLI_PATH_REAL tells the lcp patch loader WHICH bundle to patch. It does
# NOT choose what runs: /root/.bun/bin/letta is a symlink, and that symlink is
# the thing that executes. Move BOTH on an upgrade or the server quietly runs
# the old version, or runs unpatched with no boot summary at all.
#
#   ln -sfn /root/letta-code-<version>/node_modules/@letta-ai/letta-code/letta.js \
#           /root/.bun/bin/letta
#
# After restarting, confirm the boot line in /var/log/meridian-appserver.log
# names the NEW path and reads `applied=18 skipped=0`. A lower applied count
# means an anchor drifted and that patch is silently inert.
#
# --max-old-space-size must stay BELOW MemoryMax in
# scripts/deploy/meridian-appserver.memory-protection.conf (4G against 6G) so a
# runaway hits the V8 ceiling and crashes cleanly rather than being OOM-killed,
# and ABOVE the measured working set (2.7GB) or a stall becomes a crash loop.
NODE_OPTIONS=--import=file:///opt/stacks/letta-code-parallel/admin-shim/scripts/letta-code-patch-register.mjs --max-old-space-size=4096
LETTA_CLI_PATH_REAL=/root/letta-code-0.32.3/node_modules/@letta-ai/letta-code/letta.js

LCP_VISION_DEBUG=1
