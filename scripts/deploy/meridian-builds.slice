# Managed by scripts/deploy/install-meridian.sh in oculairmedia/letta-mobile.
# Edit it there, not on the host: `install-meridian.sh --check` compares the two
# byte for byte, so a hand edit here shows up as drift and gets overwritten.
# See scripts/deploy/README-stall-diagnostics.md for the incident behind it.

[Unit]
# letta-mobile-jsfrn (2026-08-23). Agent-spawned Gradle/Kotlin builds were running
# INSIDE the production App Server cgroup (observed: gradle -Xmx4g RSS 1.09GB +
# kotlin daemon RSS 1.00GB as children of meridian-appserver.service). Two ways
# that hurts:
#   1. android-compose/gradle.properties configures org.gradle.jvmargs=-Xmx4096m
#      AND kotlin.daemon.jvmargs=-Xmx4096m -- up to 8GB of heap that can drive a
#      busy 48GB host into swap and stall the App Server's event loop.
#   2. meridian-appserver uses KillMode=control-group, so restarting the App
#      Server REAPS in-flight builds (confirmed during the 16:28 restart).
# Builds belong in their own accounting domain, not the production service's.
Description=Meridian agent-spawned builds (isolated from the App Server cgroup)
Before=slices.target

[Slice]
# Compiler heaps, native memory and test workers exceed the old 8G reclaim
# threshold. Do not throttle builds via MemoryHigh when host RAM is available.
# Keep a 24G runaway backstop, isolated from the production App Server.
MemoryHigh=infinity
MemoryMax=24G
# Builds are batch work: yield CPU to the production path under contention.
CPUWeight=20
IOWeight=20
