# Managed by scripts/deploy/install-meridian.sh in oculairmedia/letta-mobile.
# Edit it there, not on the host: `install-meridian.sh --check` compares the two
# byte for byte, so a hand edit here shows up as drift and gets overwritten.
# See scripts/deploy/README-stall-diagnostics.md for the incident behind it.

[Unit]
Description=Migrate agent-spawned build daemons out of the App Server cgroup
Documentation=https://github.com/oculairmedia/letta-mobile
After=meridian-appserver.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/meridian/adopt-builds.sh
# Only privilege needed is writing cgroup.procs under /sys/fs/cgroup.
NoNewPrivileges=true
