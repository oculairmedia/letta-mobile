# Managed by scripts/deploy/install-meridian.sh in oculairmedia/letta-mobile.
# Edit it there, not on the host: `install-meridian.sh --check` compares the two
# byte for byte, so a hand edit here shows up as drift and gets overwritten.
# See scripts/deploy/README-stall-diagnostics.md for the incident behind it.

[Unit]
Description=Periodically re-home agent-spawned build daemons (letta-mobile-jsfrn)

[Timer]
# Gradle/Kotlin daemons are long-lived, so catching them within a minute is
# ample -- the goal is to stop them ACCUMULATING in the production cgroup, not
# to intercept them at exec time.
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=15s
Unit=meridian-build-adopter.service

[Install]
WantedBy=timers.target
