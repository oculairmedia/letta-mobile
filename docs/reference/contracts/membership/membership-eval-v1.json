{
  "contract": "membership/eval",
  "version": 1,
  "notes": "Evaluation cases (membership-v1.md section 6). Each op is described by fields; a runner signs it with the test key named by issuer (seed = the key number repeated 32 times) and resolves parents by op label. ts_ms defaults to 0. caps are a list or preset:<name>. A rotate's proof of possession is signed by new_key unless pop_signer names another key. Policies use the value notation of bcbor-v1.json. expect.status lists every node id with a status, exactly. expect.caps lists the capabilities of every active member (absent means none). rejections lists every op that has no effect, exactly, with its code. Every case must give the same result for every arrival order; cases with permutations = all are run in every order. Hand-written; the op ids named in expectations of the two order-sensitive cases were filled in from the reference implementation and are stable because keys and bodies are fixed.",
  "roots": {
    "R0": "00000000000000000000000000000000",
    "R1": "11111111111111111111111111111111",
    "R2": "22222222222222222222222222222222",
    "R3": "33333333333333333333333333333333"
  },
  "cases": [
    {
      "name": "linear_chain",
      "ops": [
        { "op": "g", "kind": "genesis", "issuer": "N1", "caps_add": "preset:first_device", "catalog_root": "R0", "name": "first", "label": "home" },
        { "op": "a2", "kind": "add", "issuer": "N1", "parents": ["g"], "subject": "N2", "caps_add": "preset:desktop_node", "name": "desk2" },
        { "op": "a3", "kind": "add", "issuer": "N1", "parents": ["a2"], "subject": "N3", "caps_add": "preset:phone" },
        { "op": "gr3", "kind": "grant", "issuer": "N1", "parents": ["a3"], "subject": "N3", "caps_add": ["node.execute"] }
      ],
      "expect": {
        "status": { "N1": "active", "N2": "active", "N3": "active" },
        "caps": { "N1": "preset:first_device", "N2": "preset:desktop_node", "N3": "preset:phone_execution" },
        "admins": ["N1"],
        "locked": false,
        "catalog_root": "R0",
        "superseded_roots": [],
        "names": { "N1": "first", "N2": "desk2" },
        "label": "home"
      },
      "rejections": {}
    },
