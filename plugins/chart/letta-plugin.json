{
  "manifestVersion": 1,
  "id": "letta.chart",
  "name": "Chart",
  "version": "1.1.0",
  "publisher": "oculairmedia",
  "contract": { "version": 1 },
  "runtime": { "kind": "process", "command": "node", "args": ["server.mjs"], "cwd": "." },
  "capabilities": ["canvas:place", "assets:write", "ui:pages"],
  "elements": {
    "chart": {
      "schemaVersion": 2,
      "props": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "title", "labels", "values"],
        "properties": {
          "kind": { "enum": ["bar", "line"] },
          "title": { "type": "string", "maxLength": 120 },
          "labels": { "type": "array", "maxItems": 24, "items": { "type": "string", "maxLength": 32 } },
          "values": { "type": "array", "maxItems": 24, "items": { "type": "number" } }
        }
      },
      "defaultSize": { "width": 320, "height": 200 },
      "page": "chart"
    }
  },
  "actions": {
    "plot": {
      "description": "Place a bar or line chart on the canvas. labels and values are parallel arrays of the same length (1 to 24 points).",
      "visibility": ["agent", "view"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "labels", "values"],
        "properties": {
          "kind": { "enum": ["bar", "line"], "description": "bar (the default) or line" },
          "title": { "type": "string", "maxLength": 120 },
          "labels": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "type": "string", "maxLength": 32 } },
          "values": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "type": "number" } }
        }
      }
    },
    "toggle": {
      "visibility": ["view"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["bar", "line"] },
          "title": { "type": "string", "maxLength": 120 },
          "labels": { "type": "array", "maxItems": 24, "items": { "type": "string", "maxLength": 32 } },
          "values": { "type": "array", "maxItems": 24, "items": { "type": "number" } }
        }
      }
    }
  },
  "pages": {
    "chart": {
      "html": "pages/chart.html",
      "csp": { "connectDomains": [], "resourceDomains": [], "frameDomains": [] },
      "displayModes": ["inline", "fullscreen"]
    }
  }
}
