                    <DataBindContext sourcePathIds="1:50-1:18" propertyKey="14" converterId="2:5" id="0:446"/>
                <Node x="0" y="0" name="Turn" id="0:220">
                <Node x="0" y="0" name="Arc" id="0:236">
                <Node x="0" y="0" name="Face" id="0:200">
