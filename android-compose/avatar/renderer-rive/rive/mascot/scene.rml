<Rive version="1" kind="fragment">
    <!--
        The Letta agent mascot: a flat stand-in for the 3D VRM avatar, driven by the same
        AvatarDirector states the VRM renderer obeys.

        The host writes four things on the Avatar view model and nothing else:
          state     - the director's arbitrated state, as an enum key
          mouthOpen - 0..1 speech amplitude
          lookX/Y   - -1..1 gaze, 0 being straight ahead
          blink     - fire-once

        Property NAMES are the contract with RiveAvatarContract.kt. Renaming one here breaks the
        app silently: an unknown property path writes nothing and reports nothing.
    -->
    <Artboard defaultStateMachineId="3:5" viewModelId="1:50" viewModelInstanceId="1:20"
              clip="true" width="500" height="500" name="Mascot" id="0:2">
        <Fill name="Background">
            <SolidColor colorValue="FF141414" name="Color"/>
        </Fill>

        <!--
            Eyes ride a node so one bind moves both. Gaze is authored as a small offset, not a
            rotation: a flat face has no head to turn, and faking one reads as a wobble.
        -->
        <Node x="0" y="0" name="Gaze" id="0:20">
            <DataBindContext sourcePathIds="1:50-1:3" propertyKey="13" converterId="2:1"/>
            <DataBindContext sourcePathIds="1:50-1:4" propertyKey="14" converterId="2:2"/>

            <Shape x="200" y="230" name="EyeLeft" id="0:21">
                <Ellipse width="34" height="44" name="Path"/>
                <Fill name="Fill">
                    <SolidColor colorValue="FF0B0B0B" name="Color"/>
                </Fill>
            </Shape>
            <Shape x="300" y="230" name="EyeRight" id="0:22">
                <Ellipse width="34" height="44" name="Path"/>
                <Fill name="Fill">
                    <SolidColor colorValue="FF0B0B0B" name="Color"/>
                </Fill>
            </Shape>
        </Node>

        <!--
            The mouth opens from its own centre, so the authored height is the closed mouth and the
            bind only grows it. Binding the Ellipse and not the Shape: height is a path property,
            and the enclosing Shape has none.
        -->
        <Shape x="250" y="330" name="Mouth" id="0:30">
            <Ellipse width="90" height="10" name="Path" id="0:31">
                <DataBindContext sourcePathIds="1:50-1:2" propertyKey="21" converterId="2:3"/>
            </Ellipse>
            <Fill name="Fill">
                <SolidColor colorValue="FF0B0B0B" name="Color"/>
            </Fill>
        </Shape>

        <!--
            Body. Declared LAST because the first sibling draws on top: authored before the face,
            it paints over its own eyes and the file still builds and inspects clean.
            Its colour is the state readout - every state animation keys this one paint.
        -->
        <Shape x="250" y="270" name="Body" id="0:10">
            <Ellipse width="300" height="280" name="Path"/>
            <Fill name="Fill">
                <SolidColor colorValue="FF3B82F6" name="BodyColor" id="0:11"/>
            </Fill>
        </Shape>

        <!--
            One animation per state, each holding the body colour. A single frame with a hold key is
            deliberate: this spike proves the data path, and a colour per state is the smallest
            thing that makes every director state visibly distinct.
        -->
        <LinearAnimation duration="1" name="Idle" id="3:10">
            <KeyedObject objectId="0:11">
                <KeyedProperty propertyKey="37">
                    <KeyFrameColor value="FF3B82F6" frame="0"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <LinearAnimation duration="1" name="Thinking" id="3:11">
            <KeyedObject objectId="0:11">
                <KeyedProperty propertyKey="37">
                    <KeyFrameColor value="FFE0A33E" frame="0"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <LinearAnimation duration="1" name="Speaking" id="3:12">
            <KeyedObject objectId="0:11">
                <KeyedProperty propertyKey="37">
                    <KeyFrameColor value="FF34C759" frame="0"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <LinearAnimation duration="1" name="Error" id="3:13">
            <KeyedObject objectId="0:11">
                <KeyedProperty propertyKey="37">
                    <KeyFrameColor value="FFE5484D" frame="0"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!--
            Transitions hang off AnyState so a state change is reachable from wherever the mascot
            currently is. The amber/green/red are the app's existing presence colours, so the
            mascot and the agent rail orb say the same thing.
        -->
        <StateMachine name="Avatar" id="3:5">
            <StateMachineLayer name="State" id="3:1">
                <EntryState>
                    <StateTransition stateToId="3:20"/>
                </EntryState>
                <AnyState x="220" y="-140">
                    <StateTransition stateToId="3:20" duration="160">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyEnum>
                                    <DataBindContext sourcePathIds="1:50-1:1" propertyKey="637"/>
                                </BindablePropertyEnum>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueEnumComparator value="1:101"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="3:21" duration="160">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyEnum>
                                    <DataBindContext sourcePathIds="1:50-1:1" propertyKey="637"/>
                                </BindablePropertyEnum>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueEnumComparator value="1:104"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="3:22" duration="160">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyEnum>
                                    <DataBindContext sourcePathIds="1:50-1:1" propertyKey="637"/>
                                </BindablePropertyEnum>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueEnumComparator value="1:106"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="3:23" duration="160">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyEnum>
                                    <DataBindContext sourcePathIds="1:50-1:1" propertyKey="637"/>
                                </BindablePropertyEnum>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueEnumComparator value="1:108"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnyState>
                <ExitState x="430" y="-140"/>

                <AnimationState x="200" y="40" animationId="3:10" id="3:20"/>
                <AnimationState x="200" y="140" animationId="3:11" id="3:21"/>
                <AnimationState x="200" y="240" animationId="3:12" id="3:22"/>
                <AnimationState x="200" y="340" animationId="3:13" id="3:23"/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <!--
        Every AvatarState the director can arbitrate, in its order. All twelve exist so the host can
        always write a legal value; four of them currently drive a distinct animation and the rest
        hold the idle look. That is a gap in the ART, not in the contract.
    -->
    <DataEnumCustom name="AvatarState" id="1:100">
        <DataEnumValue key="idle" value="Idle" id="1:101"/>
        <DataEnumValue key="listening" value="Listening" id="1:102"/>
        <DataEnumValue key="dragged" value="Dragged" id="1:103"/>
        <DataEnumValue key="thinking" value="Thinking" id="1:104"/>
        <DataEnumValue key="waitingInput" value="Waiting Input" id="1:105"/>
        <DataEnumValue key="speaking" value="Speaking" id="1:106"/>
        <DataEnumValue key="success" value="Success" id="1:107"/>
        <DataEnumValue key="error" value="Error" id="1:108"/>
        <DataEnumValue key="sleeping" value="Sleeping" id="1:109"/>
        <DataEnumValue key="loading" value="Loading" id="1:110"/>
        <DataEnumValue key="failed" value="Failed" id="1:111"/>
        <DataEnumValue key="degraded" value="Degraded" id="1:112"/>
    </DataEnumCustom>

    <!-- -1..1 gaze into pixels of eye travel, clamped so a bad value cannot fling the eyes off. -->
    <DataConverterRangeMapper minInput="-1" maxInput="1" minOutput="-22" maxOutput="22"
                              clampLower="true" clampUpper="true" name="GazeX" id="2:1"/>
    <DataConverterRangeMapper minInput="-1" maxInput="1" minOutput="-14" maxOutput="14"
                              clampLower="true" clampUpper="true" name="GazeY" id="2:2"/>
    <!-- 0..1 amplitude into mouth height. The floor is the closed mouth, not zero. -->
    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="10" maxOutput="86"
                              clampLower="true" clampUpper="true" name="MouthHeight" id="2:3"/>

    <ViewModel defaultInstanceId="1:20" name="Avatar" id="1:50">
        <ViewModelPropertyEnumCustom enumId="1:100" name="state" id="1:1"/>
        <ViewModelPropertyNumber name="mouthOpen" id="1:2"/>
        <ViewModelPropertyNumber name="lookX" id="1:3"/>
        <ViewModelPropertyNumber name="lookY" id="1:4"/>
        <ViewModelPropertyTrigger name="blink" id="1:5"/>

        <ViewModelInstance exports="true" name="Default" id="1:20">
            <ViewModelInstanceEnum propertyValue="1:101" viewModelPropertyId="1:1"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="1:2"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="1:3"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="1:4"/>
            <ViewModelInstanceTrigger viewModelPropertyId="1:5"/>
        </ViewModelInstance>
    </ViewModel>
</Rive>
