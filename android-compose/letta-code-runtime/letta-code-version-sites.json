{
  "note": "Every place the one letta-code pin is written, as a repository-relative path and a regular expression whose first group is the version. LettaCodeVersionPinsTest (appserver-cli) requires every match to equal the pin and the match count to equal `count`; scripts/appserver/letta-code-upgrade.mjs apply rewrites them. writer: edit = rewritten in place, npm = regenerated by npm, capture = re-captured from the installed package, generate = regenerated from the captured fixtures. Patterns are plain JavaScript/Java regex (no inline flags). History lines (for example a capture made at an older version) are not pin sites and are left alone.",
  "pin": "android-compose/letta-code-runtime/letta-code-runtime.properties",
  "sites": [
    { "path": "android-compose/letta-code-runtime/letta-code-runtime.properties", "pattern": "lettaCodeVersion=(\\d+\\.\\d+\\.\\d+)", "count": 1, "writer": "edit" },
    { "path": "android-compose/desktop/runtime/package.json", "pattern": "\"@letta-ai/letta-code\": \"(\\d+\\.\\d+\\.\\d+)\"", "count": 1, "writer": "edit" },
    { "path": "android-compose/desktop/runtime/runtime-manifest.json", "pattern": "\"lettaCode\"\\s*:\\s*\"(\\d+\\.\\d+\\.\\d+)\"", "count": 1, "writer": "edit" },
    { "path": "android-compose/desktop/runtime/package-lock.json", "pattern": "\"node_modules/@letta-ai/letta-code\": \\{\\s*\"version\": \"(\\d+\\.\\d+\\.\\d+)\"", "count": 1, "writer": "npm" },
    { "path": "android-compose/sharedLogic/src/jvmTest/resources/appserver/app-server-v2-contract-matrix.json", "pattern": "\"version\": \"(\\d+\\.\\d+\\.\\d+)\"", "count": 1, "writer": "capture" },
    { "path": "android-compose/sharedLogic/src/jvmTest/resources/appserver/installed-protocol-v2-inventory.json", "pattern": "\"version\": \"(\\d+\\.\\d+\\.\\d+)\"", "count": 1, "writer": "capture" },
    { "path": "android-compose/sharedLogic/src/jvmTest/resources/appserver/cli-version.txt", "pattern": "(\\d+\\.\\d+\\.\\d+) \\(Letta Code\\)", "count": 1, "writer": "capture" },
    { "path": "docs/reference/current-app-server-protocol.md", "pattern": "\\| Version \\| (\\d+\\.\\d+\\.\\d+) \\|", "count": 1, "writer": "generate" },
    { "path": "android-compose/sharedLogic/src/commonMain/kotlin/com/letta/mobile/data/transport/appserver/LettaCodeContract.kt", "pattern": "const val VERSION: String = \"(\\d+\\.\\d+\\.\\d+)\"", "count": 1, "writer": "edit" },
    { "path": "android-compose/sharedLogic/src/jvmTest/kotlin/com/letta/mobile/data/transport/appserver/AppServerContractBaselineTest.kt", "pattern": "assertEquals\\(\"(\\d+\\.\\d+\\.\\d+)\", baseline\\.requiredString\\(\"version\"\\)\\)", "count": 1, "writer": "edit" },
    { "path": "android-compose/sharedLogic/src/jvmTest/kotlin/com/letta/mobile/data/transport/appserver/AppServerContractBaselineTest.kt", "pattern": "assertEquals\\(\"(\\d+\\.\\d+\\.\\d+) \\(Letta Code\\)", "count": 1, "writer": "edit" },
    { "path": "android-compose/sharedLogic/src/commonMain/kotlin/com/letta/mobile/data/transport/appserver/README.md", "pattern": "@letta-ai/letta-code@(\\d+\\.\\d+\\.\\d+)", "count": 1, "writer": "edit" },
    { "path": "android-compose/sharedLogic/src/commonMain/kotlin/com/letta/mobile/data/transport/appserver/README.md", "pattern": "There is \\*\\*one\\*\\* wire contract: \\*\\*(\\d+\\.\\d+\\.\\d+)\\*\\*", "count": 1, "writer": "edit" },
    { "path": "android-compose/sharedLogic/src/commonMain/kotlin/com/letta/mobile/data/transport/appserver/README.md", "pattern": "\\| THE pin: wire contract, desktop bundled runtime, Android embedded runtime \\| (\\d+\\.\\d+\\.\\d+) \\|", "count": 1, "writer": "edit" },
    { "path": "CLAUDE.md", "pattern": "@letta-ai/letta-code@(\\d+\\.\\d+\\.\\d+)", "count": 2, "writer": "edit" },
    { "path": "AGENTS.md", "pattern": "@letta-ai/letta-code@(\\d+\\.\\d+\\.\\d+)", "count": 1, "writer": "edit" },
    { "path": "android-compose/cli/README.md", "pattern": "@letta-ai/letta-code@(\\d+\\.\\d+\\.\\d+)", "count": 3, "writer": "edit" },
    { "path": "android-compose/appserver-cli/README.md", "pattern": "@letta-ai/letta-code@(\\d+\\.\\d+\\.\\d+)", "count": 1, "writer": "edit" },
    { "path": "android-compose/appserver-cli/README.md", "pattern": "letta-code-(\\d+\\.\\d+\\.\\d+)/node_modules", "count": 1, "writer": "edit" },
    { "path": "android-compose/appserver-cli/README.md", "pattern": "# the (\\d+\\.\\d+\\.\\d+) contract", "count": 1, "writer": "edit" }
  ],
  "unionCounts": [
    { "path": "android-compose/sharedLogic/src/jvmTest/kotlin/com/letta/mobile/data/transport/appserver/AppServerContractBaselineTest.kt", "pattern": "assertEquals\\((\\d+), commands\\.size", "union": "commands" },
    { "path": "android-compose/sharedLogic/src/jvmTest/kotlin/com/letta/mobile/data/transport/appserver/AppServerContractBaselineTest.kt", "pattern": "assertEquals\\((\\d+), messages\\.size", "union": "messages" },
    { "path": "android-compose/sharedLogic/src/commonMain/kotlin/com/letta/mobile/data/transport/appserver/README.md", "pattern": "(\\d+) commands, \\d+ messages\\. Mirrors", "union": "commands" },
    { "path": "android-compose/sharedLogic/src/commonMain/kotlin/com/letta/mobile/data/transport/appserver/README.md", "pattern": "\\d+ commands, (\\d+) messages\\. Mirrors", "union": "messages" }
  ]
}
