@@ -0,0 +1,332 @@
+//! Opt-in DNS-SD peer lookup. Results are transport hints, never trust grants.
+use std::{
+    collections::{HashSet, VecDeque},
+    net::{IpAddr, SocketAddr},
+    str::FromStr,
+    sync::{Arc, Mutex},
+    time::Duration,
+};
+
+use hick::{tokio::QueryParam, Name};
+use tokio::{
+    sync::Notify,
+    task::{AbortHandle, JoinHandle},
+};
+
+use crate::{EndpointAddr, EndpointId, IrohError};
+
+const SERVICE: &str = "_irohv1._udp.local.";
+const MAX_SCAN_MS: u32 = 30_000;
+const MAX_PEERS: usize = 64;
+
+/// `Off` leaves the selected Iroh preset untouched. Both active modes use the
+/// same DNS-SD peer-lookup format; lookup clients do not advertise themselves.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, uniffi::Enum)]
+pub enum MdnsMode {
+    Off,
+    AnnounceHost,
+    LookupClient,
+}
+
+/// A candidate observed on the local network or removed when its bounded scan
+/// ends. Expiration is scan lifetime, not an assertion about remote liveness.
+#[derive(Debug, Clone, uniffi::Enum)]
+pub enum MdnsEvent {
+    Discovered { addr: Arc<EndpointAddr> },
+    Expired { id: Arc<EndpointId> },
+}
+
+struct RuntimeState {
+    browser: Option<hick::tokio::Endpoint>,
+    active: Option<ActiveScan>,
+}
+
+struct ActiveScan {
+    task: AbortHandle,
+    events: Arc<ScanEvents>,
+}
+
+#[derive(Default)]
+struct ScanQueue {
+    items: VecDeque<MdnsEvent>,
+    finished: bool,
+}
+
+#[derive(Default)]
+struct ScanEvents {
+    queue: Mutex<ScanQueue>,
+    changed: Notify,
+}
+
+impl ScanEvents {
+    fn push(&self, event: MdnsEvent) -> bool {
+        let mut queue = self.queue.lock().unwrap();
+        if queue.finished || queue.items.len() == MAX_PEERS * 2 {
+            return false;
+        }
+        queue.items.push_back(event);
+        drop(queue);
+        self.changed.notify_one();
+        true
+    }
+
+    fn finish(&self) {
+        self.queue.lock().unwrap().finished = true;
+        self.changed.notify_waiters();
+    }
+
+    fn invalidate(&self) {
+        let mut queue = self.queue.lock().unwrap();
+        queue.finished = true;
+        queue.items.clear();
+        drop(queue);
+        self.changed.notify_waiters();
+    }
+
+    async fn next(&self) -> Option<MdnsEvent> {
+        loop {
+            let notified = self.changed.notified();
+            tokio::pin!(notified);
+            notified.as_mut().enable();
+            {
+                let mut queue = self.queue.lock().unwrap();
+                if let Some(event) = queue.items.pop_front() {
+                    return Some(event);
+                }
+                if queue.finished {
+                    return None;
+                }
+            }
+            notified.await;
+        }
+    }
+}
+
+pub(crate) struct MdnsRuntime {
+    state: Mutex<RuntimeState>,
+}
+
+impl MdnsRuntime {
+    pub(crate) fn new(browser: hick::tokio::Endpoint) -> Arc<Self> {
+        Arc::new(Self {
+            state: Mutex::new(RuntimeState {
+                browser: Some(browser),
+                active: None,
+            }),
+        })
+    }
+
+    pub(crate) fn close(&self) {
+        let mut state = self.state.lock().unwrap();
+        if let Some(active) = state.active.take() {
+            active.events.invalidate();
+            active.task.abort();
+        }
+        state.browser.take();
+    }
+
+    pub(crate) async fn start_scan(
+        &self,
+        own_id: Arc<EndpointId>,
+        duration_ms: u32,
+    ) -> Result<Arc<MdnsSubscription>, IrohError> {
+        if !(1..=MAX_SCAN_MS).contains(&duration_ms) {
+            return Err(IrohError::invalid_input(
+                "mDNS scan duration must be 1..=30000 ms",
+            ));
+        }
+        let browser = self
+            .state
+            .lock()
+            .unwrap()
+            .browser
+            .clone()
+            .ok_or_else(|| IrohError::invalid_input("mDNS endpoint has been closed"))?;
+        let service = Name::try_from_str(SERVICE).map_err(anyhow::Error::from)?;
+        let duration = Duration::from_millis(u64::from(duration_ms));
+        let lookup = browser
+            .browse(
+                QueryParam::new(service)
+                    .with_timeout(duration)
+                    .with_resolve_timeout(duration)
+                    .with_max_entries(MAX_PEERS),
+            )
+            .await
+            .map_err(anyhow::Error::from)?;
+        let events = Arc::new(ScanEvents::default());
+        let mut state = self.state.lock().unwrap();
+        if state.browser.is_none() {
+            return Err(IrohError::invalid_input("mDNS endpoint has been closed"));
+        }
+        if let Some(active) = state.active.take() {
+            active.events.invalidate();
+            active.task.abort();
+        }
+        let task = tokio::spawn(run_scan(lookup, own_id, duration, events.clone()));
+        state.active = Some(ActiveScan {
+            task: task.abort_handle(),
+            events: events.clone(),
+        });
+        Ok(Arc::new(MdnsSubscription {
+            events,
+            task: Mutex::new(Some(task)),
+        }))
+    }
+}
+
+/// A single bounded browse. `close` or dropping the handle cancels its task;
+/// closing the owning endpoint cancels it as well.
+#[derive(uniffi::Object)]
+pub struct MdnsSubscription {
+    events: Arc<ScanEvents>,
+    task: Mutex<Option<JoinHandle<()>>>,
+}
+
+#[uniffi::export]
+impl MdnsSubscription {
+    #[uniffi::method(async_runtime = "tokio")]
+    pub async fn next(&self) -> Option<MdnsEvent> {
+        self.events.next().await
+    }
+
+    #[uniffi::method(async_runtime = "tokio")]
+    pub async fn close(&self) {
+        self.events.invalidate();
+        let task = self.task.lock().unwrap().take();
+        if let Some(task) = task {
+            task.abort();
+            let _ = task.await;
+        }
+    }
+}
+
+impl Drop for MdnsSubscription {
+    fn drop(&mut self) {
+        self.events.invalidate();
+        if let Some(task) = self.task.lock().unwrap().take() {
+            task.abort();
+        }
+    }
+}
+
+async fn run_scan(
+    mut lookup: hick::tokio::Lookup,
+    own_id: Arc<EndpointId>,
+    duration: Duration,
+    events: Arc<ScanEvents>,
+) {
+    let deadline = tokio::time::Instant::now() + duration;
+    let mut seen = HashSet::new();
+    while let Ok(Some(entry)) = tokio::time::timeout_at(deadline, lookup.next()).await {
+        record_candidate(&entry, &own_id, &mut seen, &events);
+    }
+    // A candidate is valid only for this scan. No stale candidate survives its
+    // bounded lifetime; a later scan must rediscover it.
+    for bytes in seen {
+        if let Ok(id) = EndpointId::from_bytes(bytes) {
+            events.push(MdnsEvent::Expired { id: Arc::new(id) });
+        }
+    }
+    events.finish();
+}
+
+fn record_candidate(
+    entry: &hick::tokio::ServiceEntry,
+    own_id: &EndpointId,
+    seen: &mut HashSet<Vec<u8>>,
+    events: &ScanEvents,
+) {
+    let Some(addr) = candidate(entry) else { return };
+    let id = addr.id();
+    let bytes = id.to_bytes();
+    if id.as_ref() == own_id || seen.contains(&bytes) || seen.len() >= MAX_PEERS {
+        return;
+    }
+    if events.push(MdnsEvent::Discovered {
+        addr: Arc::new(addr),
+    }) {
+        seen.insert(bytes);
+    }
+}
+
+fn candidate(entry: &hick::tokio::ServiceEntry) -> Option<EndpointAddr> {
+    let name = entry.instance_name().to_string();
+    let label = name.strip_suffix(SERVICE)?;
+    if label.is_empty() || label.contains('.') {
+        return None;
+    }
+    let id: EndpointId = iroh::EndpointId::from_z32(label).ok()?.into();
+    if entry.port() == 0 {
+        return None;
+    }
+    let mut addresses: Vec<String> = entry
+        .addresses()
+        .filter(|ip| usable_ip(*ip))
+        .map(|ip| SocketAddr::new(ip, entry.port()).to_string())
+        .collect();
+    // peer-lookup encodes additional IP/port pairs in binary a1=, a2= TXT
+    // segments. This is the existing peer-lookup wire format, not a new record.
+    for segment in entry.txt() {
+        let Some((key, value)) = segment.split_once(|byte| *byte == b'=') else {
+            continue;
+        };
+        if key.first() != Some(&b'a') || !key[1..].iter().all(u8::is_ascii_digit) {
+            continue;
+        }
+        let (ip, port) = match value.len() {
+            6 => (
+                IpAddr::from(<[u8; 4]>::try_from(&value[..4]).ok()?),
+                u16::from_be_bytes([value[4], value[5]]),
+            ),
+            18 => (
+                IpAddr::from(<[u8; 16]>::try_from(&value[..16]).ok()?),
+                u16::from_be_bytes([value[16], value[17]]),
+            ),
+            _ => continue,
+        };
+        if port != 0 && usable_ip(ip) {
+            addresses.push(SocketAddr::new(ip, port).to_string());
+        }
+    }
+    addresses.sort();
+    addresses.dedup();
+    if addresses.is_empty() {
+        return None;
+    }
+    Some(EndpointAddr::new(&id, None, addresses))
+}
+
+fn usable_ip(ip: IpAddr) -> bool {
+    !ip.is_unspecified() && !ip.is_multicast()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn queued_discovery_is_drained_when_scan_is_invalidated() {
+        let events = ScanEvents::default();
+        let id = EndpointId { key: [7; 32] };
+        let addr = EndpointAddr::new(&id, None, vec!["127.0.0.1:1234".into()]);
+        assert!(events.push(MdnsEvent::Discovered {
+            addr: Arc::new(addr)
+        }));
+        assert!(matches!(
+            events.next().await,
+            Some(MdnsEvent::Discovered { .. })
+        ));
+        let queued_id = EndpointId { key: [8; 32] };
+        let queued = EndpointAddr::new(&queued_id, None, vec!["127.0.0.1:1235".into()]);
+        assert!(events.push(MdnsEvent::Discovered {
+            addr: Arc::new(queued)
+        }));
+        assert_eq!(events.queue.lock().unwrap().items.len(), 1);
+        events.invalidate();
+        assert!(events.queue.lock().unwrap().items.is_empty());
+        assert!(events.next().await.is_none());
+        assert!(!events.push(MdnsEvent::Expired {
+            id: Arc::new(queued_id)
+        }));
+    }
+}
