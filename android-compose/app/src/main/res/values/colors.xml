<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Mirror of the design-system color tokens used by the system splash
      and the activity window background. The splash window runs before
      Compose, so it cannot read LettaTheme.Color values at runtime; these
      XML resources must match LettaColorTokens.LIGHT_BACKGROUND / LIGHT_ON_SURFACE and the
      Baken mark's LIGHT_MARK_STONE / LIGHT_PRIMARY tokens defined in
      sharedLogic/.../ui/theme/ThemeTokens.kt. Keep them in sync.
    -->
    <color name="letta_background">#FFEFF3F6</color>
    <color name="letta_on_background">#FF10202C</color>
    <color name="letta_mark_stone">#FF163044</color>
    <color name="letta_mark_pebble">#FFE04A32</color>
</resources>
