<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Mirror of the design-system color tokens used by the system splash
      and the activity window background. The splash window runs before
      Compose, so it cannot read LettaTheme.Color values at runtime; these
      XML resources must match LettaColorTokens.DARK_BACKGROUND / DARK_ON_SURFACE and the
      Baken mark's DARK_MARK_STONE / DARK_PRIMARY tokens defined in
      sharedLogic/.../ui/theme/ThemeTokens.kt. Keep them in sync.
    -->
    <color name="letta_background">#FF101214</color>
    <color name="letta_on_background">#FFE8EBEE</color>
    <color name="letta_mark_stone">#FFDCE6EE</color>
    <color name="letta_mark_pebble">#FFEE5A3F</color>
</resources>
