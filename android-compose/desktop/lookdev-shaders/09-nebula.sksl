uniform float2 uSize;
uniform float uTime;
uniform float uAgitation;
uniform float uEnvelope;
uniform vec4 uColor;

float hash(float2 p) {
    return fract(sin(dot(p, float2(127.1, 311.7))) * 43758.5453123);
}

float noise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    return mix(
        mix(hash(i + float2(0.0, 0.0)), hash(i + float2(1.0, 0.0)), u.x),
        mix(hash(i + float2(0.0, 1.0)), hash(i + float2(1.0, 1.0)), u.x),
        u.y
    );
}

float fbm(float2 p) {
    float v = 0.0;
    v += 0.50 * noise(p);
    v += 0.28 * noise(p * 2.1 + 13.7);
    v += 0.16 * noise(p * 4.3 + 47.1);
    return v;
}

// Nebula: two-tone cloud (tint + channel-rotated partner) drifting bottom-up.
half4 main(float2 fragCoord) {
    float2 uv = fragCoord / max(uSize, float2(1.0, 1.0));
    float t = uTime * 0.08;
    float cloudA = fbm(uv * 2.8 + float2(t, -t * 0.6));
    float cloudB = fbm(uv * 3.6 + float2(-t * 1.2, t * 0.4) + 11.0);
    float mixv = smoothstep(0.25, 0.85, cloudA + 0.15 * uAgitation * sin(uTime + uv.x * 6.0));
    float ground = smoothstep(0.35, 1.00, uv.y);
    float3 partner = uColor.rgb.gbr;
    float3 rgb = mix(partner, uColor.rgb, mixv);
    float alpha = max(cloudA, cloudB * 0.7) * mixv * ground * 0.32 * uEnvelope * uColor.a;
    return half4(rgb * alpha, alpha);
}
