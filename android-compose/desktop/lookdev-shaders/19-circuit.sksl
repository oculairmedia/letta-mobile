uniform float2 uSize;
uniform float uTime;
uniform float uAgitation;
uniform float uEnvelope;
uniform vec4 uColor;
uniform float uInvert;

const float R3 = 1.7320508;

float hash(float2 p) {
    return fract(sin(dot(p, float2(127.1, 311.7))) * 43758.5453123);
}

float noise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    return mix(
        mix(hash(i + float2(0.0, 0.0)), hash(i + float2(1.0, 0.0)), u.x),
        mix(hash(i + float2(0.0, 1.0)), hash(i + float2(1.0, 1.0)), u.x),
        u.y
    );
}

float2 rot(float2 p, float a) {
    float c = cos(a);
    float s = sin(a);
    return float2(c * p.x - s * p.y, s * p.x + c * p.y);
}

float fbm(float2 p) {
    float v = 0.0;
    float amp = 0.52;
    for (int i = 0; i < 4; i++) {
        v += amp * noise(p);
        p = rot(p, 0.62) * 2.03 + 17.3;
        amp *= 0.55;
    }
    return v;
}

float dither(float2 fragCoord) {
    return (hash(fragCoord * 0.7131) - 0.5) * (1.6 / 255.0);
}

float3 hsv(float h, float s, float v) {
    float3 k = clamp(abs(fract(h + float3(3.0, 2.0, 1.0) / 3.0) * 6.0 - 3.0) - 1.0, 0.0, 1.0);
    return mix(float3(1.0), k, s) * v;
}

float circleRing(float2 p, float r) {
    return smoothstep(0.12, 0.0, abs(length(p) - r));
}

// Hex-packed ring lattice with a radial wave travelling through the ring
// radii (ported from the user's Shadertoy). Returns ring intensity 0..1;
// the wave radius is also useful for hue cycling.
float2 ringGrid(float2 gridUv, float t) {
    float r = smoothstep(-0.7, 0.7, sin(t * 1.57 - length(gridUv) * 0.1)) + 1.0;
    float2 rep = float2(4.0, R3 * 4.0);
    float c = 0.0;
    c += circleRing(mod(gridUv, rep) - rep * 0.5, r);
    c += circleRing(mod(gridUv + float2(2.0, 0.0), rep) - rep * 0.5, r);
    c += circleRing(mod(gridUv + float2(1.0, R3), rep) - rep * 0.5, r);
    c += circleRing(mod(gridUv + float2(3.0, R3), rep) - rep * 0.5, r);
    c += circleRing(mod(gridUv + float2(0.0, R3 * 2.0), rep) - rep * 0.5, r);
    c += circleRing(mod(gridUv + float2(2.0, R3 * 2.0), rep) - rep * 0.5, r);
    c += circleRing(mod(gridUv + float2(1.0, R3 * 3.0), rep) - rep * 0.5, r);
    c += circleRing(mod(gridUv + float2(3.0, R3 * 3.0), rep) - rep * 0.5, r);
    return float2(clamp(c, 0.0, 1.0), r);
}

// Circuit: sparse grid bus-lines with warm impulses travelling along them —
// the vibe of the fractal-bus Shadertoy, rebuilt without dynamic loops (Skia
// runtime effects cannot run its while(true) path walker). Lines carry the
// tint dimly; impulses glow warm. Invert flips lines <-> cells.
half4 main(float2 fragCoord) {
    float2 uv = fragCoord / max(uSize, float2(1.0, 1.0));
    float aspect = uSize.x / max(uSize.y, 1.0);
    float2 p = float2(uv.x * aspect, uv.y) * 13.0 + float2(uTime * 0.35, uTime * 0.12);
    float2 f = fract(p);
    float2 cell = floor(p);

    float halfW = 0.05;
    float lineX = step(abs(f.x - 0.5), halfW);
    float lineY = step(abs(f.y - 0.5), halfW);

    // Sparse network: drop lines per row/column by hash so it reads as a
    // routed bus, not graph paper.
    float keepRow = step(0.35, hash(float2(0.0, cell.y)));
    float keepCol = step(0.55, hash(float2(cell.x, 0.0)));
    float lines = max(lineY * keepRow, lineX * keepCol);
    lines = mix(lines, 1.0 - lines, clamp(uInvert, 0.0, 1.0));

    // Impulses: per-row/column phase + direction from the hash; speed rises
    // with agitation. Gaussian spark along the travel axis.
    float rowDir = sign(hash(float2(7.0, cell.y)) - 0.5);
    float colDir = sign(hash(float2(cell.x, 7.0)) - 0.5);
    float sRow = fract(p.x * 0.11 * rowDir + uTime * (0.10 + 0.05 * uAgitation) + hash(float2(1.0, cell.y)));
    float sCol = fract(p.y * 0.11 * colDir + uTime * (0.08 + 0.05 * uAgitation) + hash(float2(cell.x, 1.0)));
    float impulse = max(
        lineY * keepRow * exp(-pow(sRow * 9.0, 2.0)),
        lineX * keepCol * exp(-pow(sCol * 9.0, 2.0))
    );

    float fade = smoothstep(0.05, 0.40, uv.y);
    float3 warm = float3(1.0, 0.85, 0.4);
    float aRaw = lines * 0.10 + impulse * 0.55;
    float3 rgb = mix(uColor.rgb, warm, clamp(impulse * 2.0, 0.0, 1.0));

    float alpha = clamp(aRaw * fade * uEnvelope * uColor.a, 0.0, 0.92);
    alpha = max(alpha + dither(fragCoord), 0.0);
    return half4(rgb * alpha, alpha);
}
