uniform float2 uSize;
uniform float uTime;
uniform float uAgitation;
uniform float uEnvelope;
uniform vec4 uColor;
uniform float uInvert;

const float R3 = 1.7320508;

float hash(float2 p) {
    return fract(sin(dot(p, float2(127.1, 311.7))) * 43758.5453123);
}

float noise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    return mix(
        mix(hash(i + float2(0.0, 0.0)), hash(i + float2(1.0, 0.0)), u.x),
        mix(hash(i + float2(0.0, 1.0)), hash(i + float2(1.0, 1.0)), u.x),
        u.y
    );
}

float2 rot(float2 p, float a) {
    float c = cos(a);
    float s = sin(a);
    return float2(c * p.x - s * p.y, s * p.x + c * p.y);
}

float fbm(float2 p) {
    float v = 0.0;
    float amp = 0.52;
    for (int i = 0; i < 4; i++) {
        v += amp * noise(p);
        p = rot(p, 0.62) * 2.03 + 17.3;
        amp *= 0.55;
    }
    return v;
}

float dither(float2 fragCoord) {
    return (hash(fragCoord * 0.7131) - 0.5) * (1.6 / 255.0);
}

float3 hsv(float h, float s, float v) {
    float3 k = clamp(abs(fract(h + float3(3.0, 2.0, 1.0) / 3.0) * 6.0 - 3.0) - 1.0, 0.0, 1.0);
    return mix(float3(1.0), k, s) * v;
}

float circleRing(float2 p, float r) {
    return smoothstep(0.12, 0.0, abs(length(p) - r));
}

// Hex-packed ring lattice with a radial wave travelling through the ring
// radii (ported from the user's Shadertoy). Returns ring intensity 0..1;
// the wave radius is also useful for hue cycling.
float2 ringGrid(float2 gridUv, float t) {
    float r = smoothstep(-0.7, 0.7, sin(t * 1.57 - length(gridUv) * 0.1)) + 1.0;
    float2 rep = float2(4.0, R3 * 4.0);
    float c = 0.0;
    c += circleRing(mod(gridUv, rep) - rep * 0.5, r);
    c += circleRing(mod(gridUv + float2(2.0, 0.0), rep) - rep * 0.5, r);
    c += circleRing(mod(gridUv + float2(1.0, R3), rep) - rep * 0.5, r);
    c += circleRing(mod(gridUv + float2(3.0, R3), rep) - rep * 0.5, r);
    c += circleRing(mod(gridUv + float2(0.0, R3 * 2.0), rep) - rep * 0.5, r);
    c += circleRing(mod(gridUv + float2(2.0, R3 * 2.0), rep) - rep * 0.5, r);
    c += circleRing(mod(gridUv + float2(1.0, R3 * 3.0), rep) - rep * 0.5, r);
    c += circleRing(mod(gridUv + float2(3.0, R3 * 3.0), rep) - rep * 0.5, r);
    return float2(clamp(c, 0.0, 1.0), r);
}

// Faithful port of the user's Shadertoy: hex ring lattice, hue driven by the
// travelling wave radius. Invert toggle flips the alpha mask.
half4 main(float2 fragCoord) {
    float2 uv = fragCoord / max(uSize, float2(1.0, 1.0));
    float aspect = uSize.x / max(uSize.y, 1.0);
    float2 gridUv = float2((uv.x - 0.5) * aspect, uv.y - 0.5) * 10.0;

    float2 grid = ringGrid(gridUv + 0.15 * uAgitation * float2(fbm(uv * 3.0 + uTime * 0.1) - 0.5, 0.0), uTime);
    float c = mix(grid.x, 1.0 - grid.x, clamp(uInvert, 0.0, 1.0));

    // Hue from the wave radius, leashed 40% toward the tint so it stays on-brand.
    float3 rgb = mix(hsv(grid.y + 0.7, 1.0, 1.0), uColor.rgb, 0.4);
    float fade = smoothstep(0.05, 0.45, uv.y);
    float aRaw = c * fade * 0.30;

    float alpha = clamp(aRaw * uEnvelope * uColor.a, 0.0, 0.92);
    alpha = max(alpha + dither(fragCoord), 0.0);
    return half4(rgb * alpha, alpha);
}
