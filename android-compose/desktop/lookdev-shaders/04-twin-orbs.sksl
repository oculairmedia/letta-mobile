uniform float2 uSize;
uniform float uTime;
uniform float uAgitation;
uniform float uEnvelope;
uniform vec4 uColor;

float hash(float2 p) {
    return fract(sin(dot(p, float2(127.1, 311.7))) * 43758.5453123);
}

float noise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    return mix(
        mix(hash(i + float2(0.0, 0.0)), hash(i + float2(1.0, 0.0)), u.x),
        mix(hash(i + float2(0.0, 1.0)), hash(i + float2(1.0, 1.0)), u.x),
        u.y
    );
}

float2 rot(float2 p, float a) {
    float c = cos(a);
    float s = sin(a);
    return float2(c * p.x - s * p.y, s * p.x + c * p.y);
}

float fbm(float2 p) {
    float v = 0.0;
    float amp = 0.52;
    for (int i = 0; i < 4; i++) {
        v += amp * noise(p);
        p = rot(p, 0.62) * 2.03 + 17.3;
        amp *= 0.55;
    }
    return v;
}

float dither(float2 fragCoord) {
    return (hash(fragCoord * 0.7131) - 0.5) * (1.6 / 255.0);
}

// Twin orbs: corner glows breathing in counter-phase; agitation adds flicker.
half4 main(float2 fragCoord) {
    float2 uv = fragCoord / max(uSize, float2(1.0, 1.0));
    float aspect = uSize.x / max(uSize.y, 1.0);
    float b1 = 0.5 + 0.5 * sin(uTime);
    float b2 = 0.5 + 0.5 * sin(uTime + 3.14159);
    float2 p = float2((uv.x - 0.5) * aspect, uv.y - 1.02);
    float2 c1 = float2((0.08 - 0.5) * aspect, 0.0);
    float2 c2 = float2((0.92 - 0.5) * aspect, 0.0);
    float flick1 = 1.0 + uAgitation * 0.25 * (noise(float2(uTime * 1.7, 1.0)) - 0.5);
    float flick2 = 1.0 + uAgitation * 0.25 * (noise(float2(uTime * 1.7, 7.0)) - 0.5);
    float g1 = 1.0 - smoothstep(0.0, mix(0.45, 0.60, b1) * flick1, length(p - c1));
    float g2 = 1.0 - smoothstep(0.0, mix(0.45, 0.60, b2) * flick2, length(p - c2));
    float aRaw = g1 * 0.30 + g2 * 0.30;
    float3 rgb = uColor.rgb;

    float alpha = clamp(aRaw * uEnvelope * uColor.a, 0.0, 0.92);
    alpha = max(alpha + dither(fragCoord), 0.0);
    return half4(rgb * alpha, alpha);
}
