uniform float2 uSize;
uniform float uTime;
uniform float uAgitation;
uniform float uEnvelope;
uniform vec4 uColor;

float hash(float2 p) {
    return fract(sin(dot(p, float2(127.1, 311.7))) * 43758.5453123);
}

float noise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    return mix(
        mix(hash(i + float2(0.0, 0.0)), hash(i + float2(1.0, 0.0)), u.x),
        mix(hash(i + float2(0.0, 1.0)), hash(i + float2(1.0, 1.0)), u.x),
        u.y
    );
}

float2 rot(float2 p, float a) {
    float c = cos(a);
    float s = sin(a);
    return float2(c * p.x - s * p.y, s * p.x + c * p.y);
}

float fbm(float2 p) {
    float v = 0.0;
    float amp = 0.52;
    for (int i = 0; i < 4; i++) {
        v += amp * noise(p);
        p = rot(p, 0.62) * 2.03 + 17.3;
        amp *= 0.55;
    }
    return v;
}

float dither(float2 fragCoord) {
    return (hash(fragCoord * 0.7131) - 0.5) * (1.6 / 255.0);
}

// Cinematic cosine palette (IQ): deep violet -> electric cyan -> hot magenta.
float3 palA(float t) {
    return float3(0.55, 0.42, 0.75)
         + float3(0.45, 0.45, 0.35) * cos(6.28318 * (float3(1.0, 0.9, 0.7) * t + float3(0.70, 0.35, 0.15)));
}

// Ember palette: deep indigo -> teal -> gold.
float3 palB(float t) {
    return float3(0.45, 0.40, 0.42)
         + float3(0.50, 0.42, 0.40) * cos(6.28318 * (float3(0.9, 1.0, 1.0) * t + float3(0.55, 0.30, 0.05)));
}

// Bloomed point light: tight bright core plus wide soft halo (additive).
float bloom(float d, float core, float halo) {
    return exp(-d * d / (core * core)) + 0.55 * exp(-d * d / (halo * halo));
}

// Silk: domain-warped flow with derivative lighting - folds catch light
// like fabric; palette slides through the folds.
half4 main(float2 fragCoord) {
    float2 uv = fragCoord / max(uSize, float2(1.0, 1.0));
    float aspect = uSize.x / max(uSize.y, 1.0);
    float2 p = float2(uv.x * aspect, uv.y) * 2.2;
    float t = uTime * 0.08;

    float2 q = float2(fbm(p + float2(t, -t * 0.7)), fbm(p + float2(-t * 1.1, t * 0.5) + 6.0));
    float f = fbm(p + q * (1.6 + 0.6 * uAgitation));

    float e = 0.02;
    float fx = fbm(p + float2(e, 0.0) + q * (1.6 + 0.6 * uAgitation)) - f;
    float fy = fbm(p + float2(0.0, e) + q * (1.6 + 0.6 * uAgitation)) - f;
    float3 n = normalize(float3(-fx / e, -fy / e, 2.2));
    float sheen = pow(clamp(dot(n, normalize(float3(0.4, -0.6, 0.7))), 0.0, 1.0), 3.0);

    float3 rgb = mix(palA(f * 1.4 + t), uColor.rgb, 0.30) + sheen * 0.35;
    float body = smoothstep(0.25, 0.80, f + 0.10);
    float aRaw = body * smoothstep(0.35, 0.90, uv.y) * (0.34 + 0.18 * sheen);

    float alpha = clamp(aRaw * uEnvelope * uColor.a, 0.0, 0.92);
    alpha = max(alpha + dither(fragCoord), 0.0);
    return half4(rgb * alpha, alpha);
}
