uniform float2 uSize;
uniform float uTime;
uniform float uAgitation;
uniform float uEnvelope;
uniform vec4 uColor;

float hash(float2 p) {
    return fract(sin(dot(p, float2(127.1, 311.7))) * 43758.5453123);
}

float noise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    return mix(
        mix(hash(i + float2(0.0, 0.0)), hash(i + float2(1.0, 0.0)), u.x),
        mix(hash(i + float2(0.0, 1.0)), hash(i + float2(1.0, 1.0)), u.x),
        u.y
    );
}

float2 rot(float2 p, float a) {
    float c = cos(a);
    float s = sin(a);
    return float2(c * p.x - s * p.y, s * p.x + c * p.y);
}

float fbm(float2 p) {
    float v = 0.0;
    float amp = 0.52;
    for (int i = 0; i < 4; i++) {
        v += amp * noise(p);
        p = rot(p, 0.62) * 2.03 + 17.3;
        amp *= 0.55;
    }
    return v;
}

float dither(float2 fragCoord) {
    return (hash(fragCoord * 0.7131) - 0.5) * (1.6 / 255.0);
}

// Heat: ember with a hotter near-white core cooling to the tint at the rim.
half4 main(float2 fragCoord) {
    float2 uv = fragCoord / max(uSize, float2(1.0, 1.0));
    float aspect = uSize.x / max(uSize.y, 1.0);
    float2 p = float2((uv.x - 0.50) * aspect, uv.y - 0.98);
    float breath = 0.5 + 0.5 * sin(uTime);
    float drift = fbm(float2(uv.x * 2.4 + uTime * 0.09, uv.y * 1.8 - uTime * 0.06) * (1.0 + 0.3 * uAgitation));
    float d = length(p) + (drift - 0.5) * 0.12;
    float glow = 1.0 - smoothstep(0.0, mix(0.55, 0.72, breath), d);
    float core = 1.0 - smoothstep(0.0, 0.28, d);
    float3 hot = float3(1.0, 0.96, 0.88);
    float3 rgb = mix(uColor.rgb, hot, core * 0.6);
    float aRaw = glow * smoothstep(0.45, 0.95, uv.y) * 0.40;

    float alpha = clamp(aRaw * uEnvelope * uColor.a, 0.0, 0.92);
    alpha = max(alpha + dither(fragCoord), 0.0);
    return half4(rgb * alpha, alpha);
}
