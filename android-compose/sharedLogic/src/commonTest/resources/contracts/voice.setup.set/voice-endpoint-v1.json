{
  "method": "voice.setup.set",
  "version": 1,
  "handler": "android-compose/sharedLogic/src/jvmAndAndroid/kotlin/com/letta/mobile/data/controller/node/iroh/voice/VoiceSetupHandlers.kt",
  "contract": "voice-endpoint",
  "capability": "voice_endpoint_v1",
  "required_capability": "admin.full",
  "streamed": false,
  "spec": "docs/reference/contracts/voice-endpoint-v1.md",
  "note": "Synthetic values only: example.invalid hosts, a placeholder key, a few bytes of silence and placeholder text.",
  "cases": [
    {
      "name": "first setup with key and both grants",
      "context": {"authenticated": true, "capabilities": ["admin.full"]},
      "host_state": {"controller_state": "connected", "voice": {"stored": null, "clock_ms": 1767225600000}},
      "params": {"contract_version": 1, "base_url": "https://speech.example.invalid", "transcription_model": "stt-model-a", "speech_model": "tts-model-a", "voice": "voice-a", "api_key": "placeholder-key-not-real", "grants": {"audio_for_transcription": true, "text_for_synthesis": true}},
      "expected_response": {"type": "admin_rpc_response", "request_id": "contract", "success": true, "result": {"contract_version": 1, "configured": true, "revision": "rev-1", "base_url": "https://speech.example.invalid", "has_api_key": true, "transcription": {"available": true, "model": "stt-model-a"}, "speech": {"available": true, "model": "tts-model-a", "voice": "voice-a"}, "consent": {"origin": "https://speech.example.invalid:443", "grants": {"audio_for_transcription": true, "text_for_synthesis": true}, "granted_at_ms": 1767225600000}, "reachability": {"state": "unknown"}}}
    },
    {
      "name": "same origin keeps the stored key",
      "context": {"authenticated": true, "capabilities": ["admin.full"]},
      "host_state": {"controller_state": "connected", "voice": {"stored": {"revision": "rev-1", "base_url": "https://speech.example.invalid", "has_api_key": true, "transcription_model": "stt-model-a", "speech_model": "tts-model-a", "voice": "voice-a", "grants": {"audio_for_transcription": true, "text_for_synthesis": true}, "granted_at_ms": 1767225600000, "reachability": {"state": "unknown"}}, "clock_ms": 1767225600000}},
      "params": {"contract_version": 1, "base_url": "https://speech.example.invalid", "transcription_model": "stt-model-a", "speech_model": "tts-model-a", "voice": "voice-b", "language": "en", "grants": {"audio_for_transcription": true, "text_for_synthesis": true}, "expected_revision": "rev-1"},
      "expected_response": {"type": "admin_rpc_response", "request_id": "contract", "success": true, "result": {"contract_version": 1, "configured": true, "revision": "rev-2", "base_url": "https://speech.example.invalid", "has_api_key": true, "transcription": {"available": true, "model": "stt-model-a", "language": "en"}, "speech": {"available": true, "model": "tts-model-a", "voice": "voice-b"}, "consent": {"origin": "https://speech.example.invalid:443", "grants": {"audio_for_transcription": true, "text_for_synthesis": true}, "granted_at_ms": 1767225600000}, "reachability": {"state": "unknown"}}}
    },
    {
      "name": "new origin never inherits the key",
      "context": {"authenticated": true, "capabilities": ["admin.full"]},
      "host_state": {"controller_state": "connected", "voice": {"stored": {"revision": "rev-2", "base_url": "https://speech.example.invalid", "has_api_key": true, "transcription_model": "stt-model-a", "speech_model": "tts-model-a", "voice": "voice-a", "grants": {"audio_for_transcription": true, "text_for_synthesis": true}, "granted_at_ms": 1767225600000, "reachability": {"state": "reachable", "checked_at_ms": 1767225600000}}, "clock_ms": 1767225700000}},
      "params": {"contract_version": 1, "base_url": "https://other-speech.example.invalid", "speech_model": "tts-model-a", "voice": "voice-a", "grants": {"audio_for_transcription": false, "text_for_synthesis": true}},
      "expected_response": {"type": "admin_rpc_response", "request_id": "contract", "success": true, "result": {"contract_version": 1, "configured": true, "revision": "rev-3", "base_url": "https://other-speech.example.invalid", "has_api_key": false, "transcription": {"available": false}, "speech": {"available": true, "model": "tts-model-a", "voice": "voice-a"}, "consent": {"origin": "https://other-speech.example.invalid:443", "grants": {"audio_for_transcription": false, "text_for_synthesis": true}, "granted_at_ms": 1767225700000}, "reachability": {"state": "unknown"}}}
    },
    {
      "name": "key removed",
      "context": {"authenticated": true, "capabilities": ["admin.full"]},
      "host_state": {"controller_state": "connected", "voice": {"stored": {"revision": "rev-3", "base_url": "http://127.0.0.1:8880", "has_api_key": true, "speech_model": "tts-model-a", "voice": "voice-a", "grants": {"audio_for_transcription": false, "text_for_synthesis": true}, "granted_at_ms": 1767225600000, "reachability": {"state": "unknown"}}, "clock_ms": 1767225600000}},
      "params": {"contract_version": 1, "base_url": "http://127.0.0.1:8880", "speech_model": "tts-model-a", "voice": "voice-a", "remove_api_key": true, "grants": {"audio_for_transcription": false, "text_for_synthesis": true}},
      "expected_response": {"type": "admin_rpc_response", "request_id": "contract", "success": true, "result": {"contract_version": 1, "configured": true, "revision": "rev-4", "base_url": "http://127.0.0.1:8880", "has_api_key": false, "transcription": {"available": false}, "speech": {"available": true, "model": "tts-model-a", "voice": "voice-a"}, "consent": {"origin": "http://127.0.0.1:8880", "grants": {"audio_for_transcription": false, "text_for_synthesis": true}, "granted_at_ms": 1767225600000}, "reachability": {"state": "unknown"}}}
    },
    {
      "name": "key over plain http to another machine",
      "context": {"authenticated": true, "capabilities": ["admin.full"]},
      "host_state": {"controller_state": "connected", "voice": {"stored": null}},
      "params": {"contract_version": 1, "base_url": "http://speech.example.invalid", "speech_model": "tts-model-a", "voice": "voice-a", "api_key": "placeholder-key-not-real", "grants": {"audio_for_transcription": false, "text_for_synthesis": true}},
      "expected_response": {"type": "admin_rpc_response", "request_id": "contract", "success": false, "error": "voice.insecure_transport"},
      "expected_code": "voice.insecure_transport"
    },
    {
      "name": "address with a query",
      "context": {"authenticated": true, "capabilities": ["admin.full"]},
      "host_state": {"controller_state": "connected", "voice": {"stored": null}},
      "params": {"contract_version": 1, "base_url": "https://speech.example.invalid/?token=x", "speech_model": "tts-model-a", "voice": "voice-a", "grants": {"audio_for_transcription": false, "text_for_synthesis": true}},
      "expected_response": {"type": "admin_rpc_response", "request_id": "contract", "success": false, "error": "voice.invalid_request"},
      "expected_code": "voice.invalid_request"
    },
    {
      "name": "stale revision",
      "context": {"authenticated": true, "capabilities": ["admin.full"]},
      "host_state": {"controller_state": "connected", "voice": {"stored": {"revision": "rev-5", "base_url": "https://speech.example.invalid", "has_api_key": true, "speech_model": "tts-model-a", "voice": "voice-a", "grants": {"audio_for_transcription": false, "text_for_synthesis": true}, "granted_at_ms": 1767225600000, "reachability": {"state": "unknown"}}}},
      "params": {"contract_version": 1, "base_url": "https://speech.example.invalid", "speech_model": "tts-model-a", "voice": "voice-a", "grants": {"audio_for_transcription": false, "text_for_synthesis": true}, "expected_revision": "rev-4"},
      "expected_response": {"type": "admin_rpc_response", "request_id": "contract", "success": false, "error": "voice.revision_conflict"},
      "expected_code": "voice.revision_conflict"
    },
    {
      "name": "chat pairing may not write",
      "context": {"authenticated": true, "capabilities": ["chat.read", "chat.send", "conversation.manage"]},
      "host_state": {"controller_state": "connected", "voice": {"stored": null}},
      "params": {"contract_version": 1, "base_url": "https://speech.example.invalid", "speech_model": "tts-model-a", "voice": "voice-a", "api_key": "placeholder-key-not-real", "grants": {"audio_for_transcription": false, "text_for_synthesis": true}},
      "expected_response": {"type": "admin_rpc_response", "request_id": "contract", "success": false, "error": "forbidden", "capability": "admin.full"},
      "expected_code": "forbidden"
    }
  ]
}
