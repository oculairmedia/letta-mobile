{
  "method": "service.credential.set",
  "version": 1,
  "handler": "android-compose/sharedLogic/src/jvmAndAndroid/kotlin/com/letta/mobile/data/controller/node/iroh/servicecredentials/ServiceCredentialHandlers.kt",
  "contract": "service-credentials",
  "capability": "service_credentials_v1",
  "required_capability": "admin.full",
  "streamed": false,
  "spec": "docs/reference/contracts/service-credentials-v1.md",
  "note": "Synthetic values only: a placeholder key, example.invalid hosts and canned TypeSafe answers; the host sends TypeSafe only its fixed synthetic test sentence.",
  "cases": [
    {
      "name": "first key with the model",
      "context": {"authenticated": true, "capabilities": ["admin.full"]},
      "host_state": {"controller_state": "connected", "service_credentials": {"stored": {}, "clock_ms": 1767225600000}},
      "params": {"contract_version": 1, "service_id": "typesafe-jev", "secret": "placeholder-key-not-real", "config": {"model": "jev-latest"}},
      "expected_response": {"type": "admin_rpc_response", "request_id": "contract", "success": true, "result": {"service_id": "typesafe-jev", "display_name": "TypeSafe Jev", "summary": "Typed judgements (score, choice, yes/no) for host features such as the voice mood gate.", "configured": true, "default_base_url": "https://api.typesafe.ai", "base_url_editable": false, "has_secret": true, "secret_label": "API key", "config_fields": [{"key": "model", "label": "Model", "help": "The Jev model or alias requests use.", "default": "jev-latest"}], "config": {"model": "jev-latest"}, "last_test": {"state": "unknown"}, "revision": "rev-1"}}
    },
    {
      "name": "a write without a secret keeps the stored one and resets the test",
      "context": {"authenticated": true, "capabilities": ["admin.full"]},
      "host_state": {"controller_state": "connected", "service_credentials": {"stored": {"typesafe-jev": {"revision": "rev-2", "config": {"model": "jev-latest"}, "has_secret": true, "last_test": {"state": "passed", "checked_at_ms": 1767225600000}}}, "clock_ms": 1767225600000}},
      "params": {"contract_version": 1, "service_id": "typesafe-jev", "config": {"model": "jev-1"}, "expected_revision": "rev-2"},
      "expected_response": {"type": "admin_rpc_response", "request_id": "contract", "success": true, "result": {"service_id": "typesafe-jev", "display_name": "TypeSafe Jev", "summary": "Typed judgements (score, choice, yes/no) for host features such as the voice mood gate.", "configured": true, "default_base_url": "https://api.typesafe.ai", "base_url_editable": false, "has_secret": true, "secret_label": "API key", "config_fields": [{"key": "model", "label": "Model", "help": "The Jev model or alias requests use.", "default": "jev-latest"}], "config": {"model": "jev-1"}, "last_test": {"state": "unknown"}, "revision": "rev-3"}}
    },
    {
      "name": "secret removed",
      "context": {"authenticated": true, "capabilities": ["admin.full"]},
      "host_state": {"controller_state": "connected", "service_credentials": {"stored": {"typesafe-jev": {"revision": "rev-1", "config": {"model": "jev-latest"}, "has_secret": true, "last_test": {"state": "unknown"}}}, "clock_ms": 1767225600000}},
      "params": {"contract_version": 1, "service_id": "typesafe-jev", "remove_secret": true, "config": {"model": "jev-latest"}},
      "expected_response": {"type": "admin_rpc_response", "request_id": "contract", "success": true, "result": {"service_id": "typesafe-jev", "display_name": "TypeSafe Jev", "summary": "Typed judgements (score, choice, yes/no) for host features such as the voice mood gate.", "configured": true, "default_base_url": "https://api.typesafe.ai", "base_url_editable": false, "has_secret": false, "secret_label": "API key", "config_fields": [{"key": "model", "label": "Model", "help": "The Jev model or alias requests use.", "default": "jev-latest"}], "config": {"model": "jev-latest"}, "last_test": {"state": "unknown"}, "revision": "rev-2"}}
    },
    {
      "name": "undeclared setting",
      "context": {"authenticated": true, "capabilities": ["admin.full"]},
      "host_state": {"controller_state": "connected", "service_credentials": {"stored": {}, "clock_ms": 1767225600000}},
      "params": {"contract_version": 1, "service_id": "typesafe-jev", "secret": "placeholder-key-not-real", "config": {"temperature": "1"}},
      "expected_response": {"type": "admin_rpc_response", "request_id": "contract", "success": false, "error": "service.invalid_request"},
      "expected_code": "service.invalid_request"
    },
    {
      "name": "address on a service with a fixed address",
      "context": {"authenticated": true, "capabilities": ["admin.full"]},
      "host_state": {"controller_state": "connected", "service_credentials": {"stored": {}, "clock_ms": 1767225600000}},
      "params": {"contract_version": 1, "service_id": "typesafe-jev", "base_url": "https://typesafe.example.invalid", "secret": "placeholder-key-not-real"},
      "expected_response": {"type": "admin_rpc_response", "request_id": "contract", "success": false, "error": "service.invalid_request"},
      "expected_code": "service.invalid_request"
    },
    {
      "name": "secret and removal together",
      "context": {"authenticated": true, "capabilities": ["admin.full"]},
      "host_state": {"controller_state": "connected", "service_credentials": {"stored": {}, "clock_ms": 1767225600000}},
      "params": {"contract_version": 1, "service_id": "typesafe-jev", "secret": "placeholder-key-not-real", "remove_secret": true},
      "expected_response": {"type": "admin_rpc_response", "request_id": "contract", "success": false, "error": "service.invalid_request"},
      "expected_code": "service.invalid_request"
    },
    {
      "name": "stale revision",
      "context": {"authenticated": true, "capabilities": ["admin.full"]},
      "host_state": {"controller_state": "connected", "service_credentials": {"stored": {"typesafe-jev": {"revision": "rev-2", "config": {"model": "jev-latest"}, "has_secret": true, "last_test": {"state": "passed", "checked_at_ms": 1767225600000}}}, "clock_ms": 1767225600000}},
      "params": {"contract_version": 1, "service_id": "typesafe-jev", "expected_revision": "rev-1"},
      "expected_response": {"type": "admin_rpc_response", "request_id": "contract", "success": false, "error": "service.revision_conflict"},
      "expected_code": "service.revision_conflict"
    },
    {
      "name": "unknown service",
      "context": {"authenticated": true, "capabilities": ["admin.full"]},
      "host_state": {"controller_state": "connected", "service_credentials": {"stored": {}, "clock_ms": 1767225600000}},
      "params": {"contract_version": 1, "service_id": "no-such-service", "secret": "placeholder-key-not-real"},
      "expected_response": {"type": "admin_rpc_response", "request_id": "contract", "success": false, "error": "service.unknown_service"},
      "expected_code": "service.unknown_service"
    },
    {
      "name": "chat pairing may not write",
      "context": {"authenticated": true, "capabilities": ["chat.read", "chat.send", "conversation.manage"]},
      "host_state": {"controller_state": "connected", "service_credentials": {"stored": {}, "clock_ms": 1767225600000}},
      "params": {"contract_version": 1, "service_id": "typesafe-jev", "secret": "placeholder-key-not-real"},
      "expected_response": {"type": "admin_rpc_response", "request_id": "contract", "success": false, "error": "forbidden", "capability": "admin.full"},
      "expected_code": "forbidden"
    }
  ]
}
