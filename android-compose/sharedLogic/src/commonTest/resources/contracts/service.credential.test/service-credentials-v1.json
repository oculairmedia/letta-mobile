      "params": {"service_id": "typesafe-jev"},
      "expected_response": {"type": "admin_rpc_response", "request_id": "contract", "success": true, "result": {"service_id": "typesafe-jev", "display_name": "TypeSafe Jev", "summary": "Typed judgements (score, choice, yes/no) for host features such as the voice mood gate.", "configured": true, "default_base_url": "https://api.typesafe.ai", "base_url_editable": false, "has_secret": true, "secret_label": "API key", "config_fields": [{"key": "model", "label": "Model", "help": "The Jev model or alias requests use.", "default": "jev-latest"}], "config": {"model": "jev-latest"}, "last_test": {"state": "failed", "checked_at_ms": 1767225600000, "error": "service.rate_limited"}, "revision": "rev-1"}}
