{
  "method": "feed.subscribe",
  "version": 1,
  "handler": "android-compose/sharedLogic/src/jvmAndAndroid/kotlin/com/letta/mobile/data/controller/node/iroh/feed/FeedRoutes.kt",
  "contract": "conversation-feed",
  "capability": "conversation_feed_v1",
  "required_capability": "chat.read",
  "streamed": false,
  "spec": "docs/reference/contracts/conversation-feed-v1.md",
  "note": "Synthetic ids only. The host's clock is fixed so its epoch is 1000. host_state.feed.turns are written through the journal's writer, in order; a delta {\"synthetic_tool_return_bytes\": n, \"tool_call_id\": id} stands for a tool_return_message whose tool_return is n bytes of 'z' (the file would otherwise be 300 KB). initiator_missed marks a turn whose initiator stopped receiving; terminal_observed is what the writer is told when it closes the turn.",
  "cases": [
    {
      "name": "snapshot when the caller has no cursor",
      "context": {
        "authenticated": true
      },
      "host_state": {
        "controller_state": "connected",
        "feed": {
          "turns": [
            {
              "agent_id": "agent-a",
              "conversation_id": "conv-1",
              "turn": "cm-1",
              "deltas": [
                {
                  "message_type": "tool_call_message",
                  "tool_call_id": "t1"
                },
                {
                  "message_type": "stop_reason",
                  "stop_reason": "end_turn"
                }
              ],
              "terminal_observed": true,
              "initiator_missed": false
            }
          ]
        }
      },
      "params": {
        "conversation_id": "conv-1"
      },
      "expected_response": {
        "type": "admin_rpc_response",
        "request_id": "contract",
        "success": true,
        "result": {
          "mode": "snapshot",
          "resync_reason": "no_cursor",
          "cursor": {
            "epoch": 1000,
            "seq": 4
          },
          "base_seq": 0,
          "head_seq": 4,
          "has_more": false,
          "entries": [
            {
              "epoch": 1000,
              "seq": 1,
              "kind": "turn_open",
              "turn": "cm-1",
              "payload": {}
            },
            {
              "epoch": 1000,
              "seq": 2,
              "kind": "stream_delta",
              "turn": "cm-1",
              "payload": {
                "message_type": "tool_call_message",
                "tool_call_id": "t1"
              }
            },
            {
              "epoch": 1000,
              "seq": 3,
              "kind": "stream_delta",
              "turn": "cm-1",
              "payload": {
                "message_type": "stop_reason",
                "stop_reason": "end_turn"
              }
            },
            {
              "epoch": 1000,
              "seq": 4,
              "kind": "turn_closed",
              "turn": "cm-1",
              "payload": {
                "terminal_observed": true
              }
            }
          ]
        }
      }
    },
