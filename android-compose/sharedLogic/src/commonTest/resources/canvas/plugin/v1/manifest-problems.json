{
  "about": "Manifests refused by the strict letta-plugin.json contract (letta-mobile-s416w.24): each case patches manifest-example.json (set: JSON pointer -> value, remove: pointers) and lists every problem as '<pointer> <code>'.",
  "base": "manifest-example.json",
  "cases": [
    { "name": "unknown top-level field", "set": { "/extra": 1 }, "expected": ["/extra UNKNOWN_FIELD"] },
    { "name": "missing id", "remove": ["/id"], "expected": ["/id MISSING_FIELD"] },
    { "name": "id not publisher.name lowercase", "set": { "/id": "Letta" }, "expected": ["/id BAD_PATTERN"] },
    { "name": "version not semver", "set": { "/version": "1.2" }, "expected": ["/version BAD_PATTERN"] },
    { "name": "manifestVersion unknown", "set": { "/manifestVersion": 2 }, "expected": ["/manifestVersion NOT_ALLOWED"] },
    { "name": "capability outside the closed enum", "set": { "/capabilities/1": "canvas:write" }, "expected": ["/capabilities/1 NOT_ALLOWED"] },
    { "name": "capability listed twice", "set": { "/capabilities/1": "canvas:place" }, "expected": ["/capabilities/1 DUPLICATE"] },
    { "name": "contract version the host does not speak", "set": { "/contract/version": 2 }, "expected": ["/contract/version UNSUPPORTED_CONTRACT"] },
    { "name": "unknown runtime kind", "set": { "/runtime": { "kind": "wasm" } }, "expected": ["/runtime/kind NO_BRANCH"] },
    { "name": "unknown runtime field", "set": { "/runtime/main": "x" }, "expected": ["/runtime/main UNKNOWN_FIELD"] },
    { "name": "jar outside the package", "set": { "/runtime/jar": "../plugin.jar" }, "expected": ["/runtime/jar BAD_PATH"] },
    { "name": "origin with a path", "set": { "/net/connect/0": "https://api.example.test/v1" }, "expected": ["/net/connect/0 BAD_ORIGIN"] },
    { "name": "wildcard over a single label", "set": { "/net/connect/0": "https://*.test" }, "expected": ["/net/connect/0 BAD_ORIGIN"] },
    { "name": "origins without net:connect", "set": { "/capabilities": ["canvas:place", "ui:pages"] }, "expected": ["/net/connect CAPABILITY_MISSING"] },
    { "name": "pages without ui:pages", "set": { "/capabilities": ["canvas:place", "net:connect"] }, "expected": ["/pages CAPABILITY_MISSING"] },
    { "name": "element kinds without canvas:place", "set": { "/capabilities": ["net:connect", "ui:pages"] }, "expected": ["/elements CAPABILITY_MISSING"] },
    { "name": "net:connect without origins", "set": { "/net/connect": [] }, "expected": ["/net/connect NO_ORIGINS"] },
    { "name": "element names a page that does not exist", "set": { "/elements/widget/page": "panel" }, "expected": ["/elements/widget/page UNKNOWN_PAGE"] },
    { "name": "page html outside the package", "set": { "/pages/widget/html": "../widget.html" }, "expected": ["/pages/widget/html BAD_PATH"] },
    { "name": "page html outside pages/", "set": { "/pages/widget/html": "widget.html" }, "expected": ["/pages/widget/html BAD_PATH"] },
    { "name": "page permission not declared", "set": { "/pages/widget/permissions": ["ui:camera"] }, "expected": ["/pages/widget/permissions/0 CAPABILITY_MISSING"] },
    { "name": "page permission that is not one", "set": { "/pages/widget/permissions": ["canvas:read"] }, "expected": ["/pages/widget/permissions/0 NOT_ALLOWED"] },
    { "name": "CSP domain with a path", "set": { "/pages/widget/csp/connectDomains": ["https://x.example.test/path"] }, "expected": ["/pages/widget/csp/connectDomains/0 BAD_ORIGIN"] },
    { "name": "props schema open", "set": { "/elements/widget/props/additionalProperties": true }, "expected": ["/elements/widget/props BAD_PROPS_SCHEMA"] },
    { "name": "props not flat", "set": { "/elements/widget/props/properties/meta": { "type": "object" } }, "expected": ["/elements/widget/props/properties/meta BAD_PROPS_SCHEMA"] },
    { "name": "props string too long", "set": { "/elements/widget/props/properties/label/maxLength": 5000 }, "expected": ["/elements/widget/props/properties/label/maxLength BAD_PROPS_SCHEMA"] },
    { "name": "migration from the current version", "set": { "/elements/widget/migrations/2": [] }, "expected": ["/elements/widget/migrations/2 BAD_MIGRATION"] },
    { "name": "migration step with two ops", "set": { "/elements/widget/migrations/1/0": { "rename": ["a", "b"], "drop": "c" } }, "expected": ["/elements/widget/migrations/1/0 BAD_MIGRATION"] },
    { "name": "migration step that is not declarative", "set": { "/elements/widget/migrations/1/0": { "move": ["a", "b"] } }, "expected": ["/elements/widget/migrations/1/0/move UNKNOWN_FIELD"] },
    { "name": "migration default of an object", "set": { "/elements/widget/migrations/1/1": { "default": ["status", { "x": 1 }] } }, "expected": ["/elements/widget/migrations/1/1 BAD_MIGRATION"] },
    { "name": "migration key not a version", "set": { "/elements/widget/migrations/one": [] }, "expected": ["/elements/widget/migrations/one BAD_PATTERN"] },
    { "name": "kind name outside the pattern", "set": { "/elements/Bad_Kind": { "schemaVersion": 1, "props": { "type": "object", "additionalProperties": false, "properties": {} } } }, "expected": ["/elements/Bad_Kind BAD_PATTERN"] },
    { "name": "agent action without a description", "remove": ["/actions/start/description"], "expected": ["/actions/start/description MISSING_DESCRIPTION"] },
    { "name": "visibility outside the enum", "set": { "/actions/start/visibility": ["agent", "model"] }, "expected": ["/actions/start/visibility/1 NOT_ALLOWED"] },
    { "name": "action input not an object schema", "set": { "/actions/start/input": { "type": "string" } }, "expected": ["/actions/start/input/type BAD_INPUT_SCHEMA"] },
    { "name": "action name outside the tool pattern", "set": { "/actions/Start-Job": { "description": "x", "visibility": ["agent"], "input": { "type": "object" } } }, "expected": ["/actions/Start-Job BAD_PATTERN"] },
    { "name": "setting default out of range", "set": { "/settings/quality/default": 101 }, "expected": ["/settings/quality/default OUT_OF_RANGE"] },
    { "name": "setting type unknown", "set": { "/settings/quality/type": "float" }, "expected": ["/settings/quality/type NOT_ALLOWED"] },
    { "name": "enum setting without values", "set": { "/settings/mode": { "type": "enum" } }, "expected": ["/settings/mode/values BAD_SETTING"] },
    { "name": "setting keyword for another type", "set": { "/settings/baseUrl/minimum": 1 }, "expected": ["/settings/baseUrl/minimum BAD_SETTING"] },
    { "name": "setting name outside the pattern", "set": { "/settings/1st": { "type": "string" } }, "expected": ["/settings/1st BAD_PATTERN"] },
    { "name": "secret declared twice", "set": { "/secrets/1": { "name": "apiToken" } }, "expected": ["/secrets/1/name DUPLICATE"] },
    { "name": "env names an undeclared secret", "set": { "/runtime": { "kind": "process", "command": "node", "env": { "X": "${secrets.nope}" } } }, "expected": ["/runtime/env/X UNDECLARED_REFERENCE"] },
    { "name": "env template outside settings and secrets", "set": { "/runtime": { "kind": "process", "command": "node", "env": { "X": "${config.baseUrl}" } } }, "expected": ["/runtime/env/X BAD_TEMPLATE"] },
    { "name": "template on the command line", "set": { "/runtime": { "kind": "process", "command": "node", "args": ["--token=${secrets.apiToken}"] } }, "expected": ["/runtime/args/0 BAD_TEMPLATE"] },
    { "name": "env key outside the pattern", "set": { "/runtime": { "kind": "process", "command": "node", "env": { "lower": "x" } } }, "expected": ["/runtime/env/lower BAD_PATTERN"] },
    { "name": "cwd outside the package", "set": { "/runtime": { "kind": "process", "command": "node", "cwd": "/etc" } }, "expected": ["/runtime/cwd BAD_PATH"] },
    { "name": "command outside the package", "set": { "/runtime": { "kind": "process", "command": "../bin/run" } }, "expected": ["/runtime/command BAD_PATH"] },
    { "name": "secret in a service URL", "set": { "/runtime": { "kind": "service", "url": "wss://h.example.test/lcp?t=${secrets.apiToken}" } }, "expected": ["/runtime/url SECRET_IN_URL"] },
    { "name": "service URL not a WebSocket", "set": { "/runtime": { "kind": "service", "url": "http://h.example.test" } }, "expected": ["/runtime/url BAD_PATTERN"] }
  ]
}
