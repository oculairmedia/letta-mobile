#!/usr/bin/env bash
# Local guard before pushing.
#   1. Refuse pushes that target main / master (including deletes) directly.
#      Branch protection on the remote will reject them anyway -- this skips
#      the round-trip.
#   2. Cheap local sanity: JAVA_HOME must be set (so a later intentional
#      compile/build does not fail mysteriously).
#   3. Optional CodeScene delta (advisory) — skips when `cs` / token absent.
#   4. OPTIONAL Kotlin compile. Off by default.
#   5. OPTIONAL scripts/ci/quick-check.sh (PRE_PUSH_QUICK_CHECK=1). Off by default.
#   6. ALWAYS-ON fast guardrails (parallel, <5s total, no Gradle), when the push
#      changes .kt files: KDoc hygiene, JVM-only-API leaks in commonMain/commonTest,
#      API package overview coverage, and the package headroom / import-cycle contract
#      of the changed packages (only when the push merges from origin/main and the
#      tree carries the structure baseline). API-dump mirror freshness still runs when
#      the push changes *.api files. Each has turned full 30-minute CI runs red in
#      seconds, so they run here first, in parallel; CI still owns the full gate set.
#
# Why the compile is opt-in (2026-08-05):
#   `:app:compileRootDebugKotlin` cold-starts Gradle + Kotlin daemons and
#   configures the full multi-module graph. On the shared Proxmox `home`
#   host (CT 109, co-tenant with Jellyfin) that is enough load to OOM the
#   host — every push became a crash loop. CI already owns the real compile
#   gate (`build-apk-pass`, `test`, `shared-multiplatform`). Local compile
#   remains available when you deliberately want it:
#       PRE_PUSH_COMPILE=1 git push
#   or export PRE_PUSH_COMPILE=1 in a well-resourced environment (VPS).
set -euo pipefail

# A `local_sha` of all zeros means git is deleting `remote_ref` -- there's no
# source code being pushed, so any compile would be meaningless.
ZERO_SHA="0000000000000000000000000000000000000000"
has_content_push=0
# Push-shape inputs for the always-on fast guardrails below: whether any pushed
# range changes .kt or *.api files. `unknown_change_base` marks a range whose diff
# base cannot be resolved locally; the guardrails then run unconditionally.
kt_changed=0
api_changed=0
unknown_change_base=0
# Merge base of the pushed commits with origin/main, when one exists: the base
# package_headroom.py --changed wants (mirrors scripts/ci/quick-check.sh).
headroom_base=""

# stdin format (one line per ref being pushed):
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      # Block both pushes AND deletes targeting main / master. Branch
      # protection's `allow_deletions: false` is the real wall; this just
      # fails the action locally before round-tripping to the server.
      cat >&2 <<EOF
✗ Pushes to '$remote_ref' are blocked (including deletes).

Open a PR from a feature branch instead:
    gh pr create

(If you really must bypass: git push --no-verify -- but you almost
certainly should not.)
EOF
      exit 1
      ;;
  esac

  if [ "$local_sha" != "$ZERO_SHA" ]; then
    has_content_push=1
    # Base the package headroom guard below wants: the merge point with origin/main.
    # Branches with no shared history (orphan fixtures) leave it empty and get skipped.
    if [ -z "$headroom_base" ]; then
      headroom_base="$(git merge-base refs/remotes/origin/main "$local_sha" 2>/dev/null || true)"
    fi
    # Diff base for "what does this push change?": the remote head when the branch
    # exists there, else the branch point (merge-base with main).
    base="$remote_sha"
    if [ "$base" = "$ZERO_SHA" ]; then
      base="$(git merge-base refs/remotes/origin/main "$local_sha" 2>/dev/null || true)"
      if [ -z "$base" ]; then
        # No common history with origin/main (orphan/very fresh repo): we cannot
        # tell what changed, so the guardrails below run unconditionally.
        unknown_change_base=1
        continue
      fi
    fi
    if push_changes="$(git diff --name-only "$base" "$local_sha" 2>/dev/null)"; then
      grep -qE '\.kt$' <<<"$push_changes" && kt_changed=1 || true
      grep -qE '\.api$' <<<"$push_changes" && api_changed=1 || true
    else
      # The remote head is unknown locally (pushing over someone else's move):
      # run both guardrails rather than guessing.
      unknown_change_base=1
    fi
  fi
done

# All refs were deletes (e.g. `git push --delete origin stale-branch`).
# Nothing further to do.
if [ "$has_content_push" -eq 0 ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"

# Cheap check: JAVA_HOME present. Does not start a JVM.
if [ -z "${JAVA_HOME:-}" ]; then
  printf '%s\n' "JAVA_HOME is not set. Point it at a JDK before pushing (needed for local Android builds)." >&2
  exit 1
fi

# ALWAYS-ON fast guardrails: the seconds-cheap CI checks whose failures have burned
# full 30-minute CI runs on multiple PRs — bead/tracker ids in the KDoc of a changed
# .kt file; JVM-only APIs in commonMain/commonTest (they break the required hostNative
# and wasmJs compiles); a new production package missing from its module's Module.md;
# and a package over its type cap / an import that closes a cycle in the changed
# packages. They run in parallel so the block stays under ~5s; each runs only when the
# push changes a file in its scope; CI still owns the full gate set, so these are about
# failing in seconds instead of half an hour.
if [ "$kt_changed" -eq 1 ] || [ "$unknown_change_base" -eq 1 ]; then
  guard_dir="$(mktemp -d)"
  trap 'rm -rf "$guard_dir"' EXIT
  run_guard() { # $1 key, $2 script, remaining args: forwarded. Log+status under $guard_dir.
    local key="$1" script="$2"
    shift 2
    ( local_status=0
      python3 "$repo_root/scripts/ci/$script" "$@" >"$guard_dir/$key.log" 2>&1 || local_status=$?
      echo "$local_status" >"$guard_dir/$key.status" ) &
  }

  run_guard kdoc "check-kdoc-hygiene.py"
  run_guard kmp "check-kmp-common-leaks.py"
  run_guard api "check-api-package-coverage.py"
  if [ -n "$headroom_base" ] \
      && [ -f "$repo_root/android-compose/architecture-tests/structure-baseline.json" ]; then
    # Same flags/scripts quick-check.sh's `structure` gate uses, so the numbers agree.
    run_guard headroom "package_headroom.py" --changed --base "$headroom_base"
  else
    # Not a letta-mobile checkout descending from origin/main (e.g. a test fixture):
    # skip rather than fail the push on a repo without the structure contract.
    : >"$guard_dir/headroom.log"
    echo 0 >"$guard_dir/headroom.status"
    headroom_skipped=1
  fi
  wait || true

  declare -A GUARD_FIX=(
    [kdoc]="KDoc hygiene failed: describe intent instead of citing bead/tracker ids. Fix the files above and push again."
    [kmp]="KMP leak check failed: commonMain/commonTest must also compile for hostNative and wasmJs. Replace the JVM-only API with its multiplatform counterpart (or move it into a platform source set) and push again."
    [api]="API package coverage failed: add an overview for each new production package to its module's Module.md and push again."
    [headroom]="Package headroom failed: split a full package (or lower stale structure-baseline lines) or drop the import that closes a cycle, then push again."
  )
  guard_failed=0
  for key in kdoc kmp api headroom; do
    read -r guard_status <"$guard_dir/$key.status"
    if [ "$guard_status" != 0 ]; then
      guard_failed=1
      sed 's/^/  /' "$guard_dir/$key.log" >&2
      printf '✗ %s\n' "${GUARD_FIX[$key]}" >&2
    fi
  done
  if [ "$guard_failed" -ne 0 ]; then
    exit 1
  fi
  printf '%s\n' "[pre-push] scripts/ci/check-kdoc-hygiene.py: clean." >&2
  printf '%s\n' "[pre-push] scripts/ci/check-kmp-common-leaks.py: clean." >&2
  printf '%s\n' "[pre-push] scripts/ci/check-api-package-coverage.py: clean." >&2
  if [ "${headroom_skipped:-0}" -eq 1 ]; then
    printf '%s\n' "[pre-push] skipping scripts/ci/package_headroom.py --changed (no merge base with origin/main or no structure-baseline.json)." >&2
  else
    printf '%s\n' "[pre-push] scripts/ci/package_headroom.py --changed: contract OK." >&2
  fi
else
  printf '%s\n' "[pre-push] skipping scripts/ci/check-kdoc-hygiene.py (no .kt files in this push)." >&2
  printf '%s\n' "[pre-push] skipping scripts/ci/check-kmp-common-leaks.py (no .kt files in this push)." >&2
  printf '%s\n' "[pre-push] skipping scripts/ci/check-api-package-coverage.py (no .kt files in this push)." >&2
  printf '%s\n' "[pre-push] skipping scripts/ci/package_headroom.py --changed (no .kt files in this push)." >&2
fi

if [ "$api_changed" -eq 1 ] || [ "$unknown_change_base" -eq 1 ]; then
  bash "$repo_root/scripts/ci/api-dump-mirror-check.sh" || {
    printf '%s\n' "✗ API dump mirror check failed: after apiDump, copy each api/linux_x64 dump over its api/mingw_x64 twin (keep the klib '// Targets:' lines)." >&2
    exit 1
  }
  printf '%s\n' "[pre-push] scripts/ci/api-dump-mirror-check.sh: clean." >&2
else
  printf '%s\n' "[pre-push] skipping scripts/ci/api-dump-mirror-check.sh (no *.api files in this push)." >&2
fi

# Optional heavy compile — off by default (see header).
if [ "${PRE_PUSH_COMPILE:-0}" = "1" ]; then
  cd "$repo_root/android-compose"
  ./gradlew :app:compileRootDebugKotlin
else
  printf '%s\n' "[pre-push] skipping :app:compileRootDebugKotlin (set PRE_PUSH_COMPILE=1 to enable; CI owns the compile gate)." >&2
fi

# Optional source guardrails (parity, platform UI, KDoc, API packages, baseline ratchet, package
# type caps and import cycles) in seconds, without Gradle. Opt in with PRE_PUSH_QUICK_CHECK=1;
# a failure blocks the push.
if [ "${PRE_PUSH_QUICK_CHECK:-0}" = "1" ]; then
  bash "$repo_root/scripts/ci/quick-check.sh" || exit 1
fi

# CodeScene delta (advisory) — surfaces the code-health findings the
# "CodeScene Code Health Review" PR check would flag, before the push.
# Skips silently when the `cs` CLI or CS_ACCESS_TOKEN is absent; set
# CS_DELTA_GATE=1 to make findings block the push.
"$repo_root/scripts/codescene/cs-delta.sh" || exit 1
